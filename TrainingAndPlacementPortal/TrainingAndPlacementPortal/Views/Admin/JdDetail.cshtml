@{ ViewData["Title"] = "JD Detail"; }

<div class="w-full">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 md:gap-0 relative z-10">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-red-600">Company Management</h1>
            <p class="text-gray-600 text-sm">Update and Verify company details for campus drives.</p>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <button id="editJdBtn" data-editing="false" onclick="toggleJdEdit()" class="bg-red-600 text-white px-5 py-2 rounded-lg flex-1 md:flex-none hover:bg-red-700 border-none cursor-pointer font-medium">Edit Content</button>
            <a href="/AdminCompanyManagement" class="border px-5 py-2 rounded-lg flex-1 md:flex-none text-center no-underline text-gray-800 hover:bg-gray-50 bg-white">← Back</a>
        </div>
    </div>

    <!-- Form Title -->
    <div class="bg-white rounded-xl shadow-sm p-4 md:p-6 text-center mb-6">
        <h2 class="text-lg font-semibold">Campus Placement Registration Form</h2>
        <p class="text-gray-500 text-sm">RK University, Rajkot – Training &amp; Placement Cell</p>
    </div>

    <div id="loadingIndicator" class="flex justify-center items-center py-10">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600"></div>
    </div>

    <div id="jdFormContainer" class="hidden">
        <!-- Contact Information (Static Display of university admins) -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-address-book"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Contact Information</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div class="bg-gray-100 p-4 rounded-lg"><p class="font-semibold">Dr. Vishal Doshi</p><p class="text-sm text-gray-600">Head of Training &amp; Placement Cell</p><p class="text-sm">+91 98765 43210</p></div>
                <div class="bg-gray-100 p-4 rounded-lg"><p class="font-semibold">Mr. Osho Shah</p><p class="text-sm text-gray-600">Assistant Training &amp; Placement Officer</p><p class="text-sm">+91 87654 32109</p></div>
            </div>
        </div>

        <!-- Company Details -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-building"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Company Details</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Email Address *</label><input id="compEmail" type="email" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Name *</label><input id="companyName" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Job Location *</label><input id="jobLocation" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Website URL *</label><input id="website" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div class="md:col-span-2"><textarea id="description" rows="4" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500"></textarea></div>
            </div>
        </div>

        <!-- Job Role -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-briefcase"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Job Role &amp; Compensation</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Job Position</label><input id="jobPosition" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Annual CTC</label><input id="annualCTC" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Internship Duration</label><input id="internshipDuration" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Stipend During Internship</label><input id="stipend" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Bond</label><input id="bond" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Date of Joining</label><input id="dateOfJoining" type="date" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
            </div>
        </div>

        <!-- Eligibility -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Eligibility Criteria</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="font-semibold text-sm mb-2">Eligible Batch</p>
                    <div id="batchContainer" class="flex flex-wrap gap-3">
                        @foreach (var b in new[] { "2025", "2024", "2023" }) { <label class="flex items-center gap-2"><input type="checkbox" value="@b" disabled class="jd-editable batch-cb" /> @b</label> }
                    </div>
                </div>
                <div>
                    <p class="font-semibold text-sm mb-2">Eligible Courses</p>
                    <div id="courseContainer" class="flex flex-wrap gap-3">
                        @foreach (var c in new[] { "B.Tech CS", "B.Tech IT", "Mechanical", "Civil", "Electrical", "BCA", "MCA", "MBA" }) {
                            <label class="flex items-center gap-2"><input type="checkbox" value="@c" disabled class="jd-editable course-cb" /> @c</label>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Selection Process -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Selection Process</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2"><textarea id="selectionProcess" rows="3" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500"></textarea></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Expected Date of Campus Drive</label><input id="campusDriveDate" type="date" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Registration Link (Optional)</label><input id="registrationLink" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
            </div>
        </div>

        <!-- Contact Person -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Contact Person Details</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact Person Name</label><input id="contactName" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact Person Email ID</label><input id="contactEmail" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact Person Mobile No</label><input id="contactMobile" type="text" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
            </div>
        </div>

        <!-- Additional Details -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Additional Details</h2>
            </div>
            <textarea id="additionalNotes" rows="4" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500"></textarea>
        </div>

        <!-- Save/Cancel Buttons -->
        <div id="jdSaveArea" class="flex flex-col-reverse md:flex-row justify-end gap-4 mt-6 hidden">
            <button onclick="cancelJdEdit()" class="border px-6 py-2 rounded-lg hover:bg-gray-50 w-full md:w-auto bg-white cursor-pointer">CANCEL</button>
            <button onclick="saveJdApi()" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 w-full md:w-auto border-none cursor-pointer">Save Changes</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentJdId = null;
        let originalData = {};

        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Admin')) return;
            
            const params = new URLSearchParams(window.location.search);
            currentJdId = params.get('id');

            if (!currentJdId) {
                document.getElementById('loadingIndicator').innerHTML = '<p class="text-red-500">Invalid JD ID.</p>';
                return;
            }

            await loadJdDetail();
            
            if (params.get('edit') === 'true') {
                toggleJdEdit();
            }
        });

        async function loadJdDetail() {
            try {
                const res = await authFetch(`/api/company/job-postings/${currentJdId}`);
                if (!res || !res.ok) throw new Error('Failed to fetch');
                const data = await res.json();
                
                if (data.success) {
                    populateForm(data.data);
                    document.getElementById('loadingIndicator').classList.add('hidden');
                    document.getElementById('jdFormContainer').classList.remove('hidden');
                } else {
                    document.getElementById('loadingIndicator').innerHTML = `<p class="text-red-500">${data.message}</p>`;
                }
            } catch (err) {
                console.error(err);
                document.getElementById('loadingIndicator').innerHTML = '<p class="text-red-500">Error loading JD details.</p>';
            }
        }

        function populateForm(jd) {
            originalData = jd;
            document.getElementById('compEmail').value = jd.companyEmail || '';
            document.getElementById('companyName').value = jd.companyName || '';
            document.getElementById('jobLocation').value = jd.jobLocation || '';
            document.getElementById('website').value = jd.website || '';
            document.getElementById('description').value = jd.description || '';
            
            document.getElementById('jobPosition').value = jd.jobPosition || '';
            document.getElementById('annualCTC').value = jd.annualCTC || '';
            document.getElementById('internshipDuration').value = jd.internshipDuration || '';
            document.getElementById('stipend').value = jd.stipend || '';
            document.getElementById('bond').value = jd.bond || '';
            document.getElementById('dateOfJoining').value = jd.dateOfJoining ? jd.dateOfJoining.split('T')[0] : '';
            
            document.getElementById('selectionProcess').value = jd.selectionProcess || '';
            document.getElementById('campusDriveDate').value = jd.campusDriveDate ? jd.campusDriveDate.split('T')[0] : '';
            document.getElementById('registrationLink').value = jd.registrationLink || '';
            
            document.getElementById('contactName').value = jd.contactName || '';
            document.getElementById('contactEmail').value = jd.contactEmail || '';
            document.getElementById('contactMobile').value = jd.contactMobile || '';
            document.getElementById('additionalNotes').value = jd.additionalNotes || '';
            
            // Checkboxes
            const batches = (jd.eligibleBatches || '').split(',').map(b => b.trim());
            document.querySelectorAll('.batch-cb').forEach(cb => { cb.checked = batches.includes(cb.value); });
            
            const courses = (jd.eligibleCourses || '').split(',').map(c => c.trim());
            document.querySelectorAll('.course-cb').forEach(cb => { cb.checked = courses.includes(cb.value); });
        }

        async function saveJdApi() {
            const dto = {
                companyName: document.getElementById('companyName').value,
                email: document.getElementById('compEmail').value,
                website: document.getElementById('website').value,
                jobLocation: document.getElementById('jobLocation').value,
                description: document.getElementById('description').value,
                contactName: document.getElementById('contactName').value,
                contactEmail: document.getElementById('contactEmail').value,
                contactMobile: document.getElementById('contactMobile').value,
                
                jobPosition: document.getElementById('jobPosition').value,
                annualCTC: document.getElementById('annualCTC').value,
                internshipDuration: document.getElementById('internshipDuration').value,
                stipend: document.getElementById('stipend').value,
                bond: document.getElementById('bond').value,
                dateOfJoining: document.getElementById('dateOfJoining').value,
                
                eligibleBatches: Array.from(document.querySelectorAll('.batch-cb')).filter(cb => cb.checked).map(cb => cb.value).join(', '),
                eligibleCourses: Array.from(document.querySelectorAll('.course-cb')).filter(cb => cb.checked).map(cb => cb.value).join(', '),
                                     
                selectionProcess: document.getElementById('selectionProcess').value,
                campusDriveDate: document.getElementById('campusDriveDate').value,
                registrationLink: document.getElementById('registrationLink').value,
                additionalNotes: document.getElementById('additionalNotes').value
            };

            try {
                const res = await authFetch(`/api/company/job-postings/${currentJdId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });

                if (res && res.ok) {
                    const result = await res.json();
                    if (result.success) {
                        alert(result.message);
                        cancelJdEdit(); // Toggle back to view mode
                        await loadJdDetail(); // Reload latest
                    } else {
                        alert('Error: ' + result.message);
                    }
                } else {
                    alert('Failed to update JD.');
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred.');
            }
        }
    </script>
}
