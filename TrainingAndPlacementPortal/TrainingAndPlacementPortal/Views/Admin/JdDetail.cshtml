@{ ViewData["Title"] = "JD Detail"; }

<div class="w-full">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 md:gap-0 relative z-10">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-red-600">Company Management</h1>
            <p class="text-gray-600 text-sm">Update and Verify company details for campus drives.</p>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <button id="editJdBtn" data-editing="false" onclick="toggleJdEdit()" class="bg-red-600 text-white px-5 py-2 rounded-lg flex-1 md:flex-none hover:bg-red-700 border-none cursor-pointer font-medium">Edit Content</button>
            <a href="/AdminCompanyManagement" class="border px-5 py-2 rounded-lg flex-1 md:flex-none text-center no-underline text-gray-800 hover:bg-gray-50 bg-white">← Back</a>
        </div>
    </div>

    <!-- Loading -->
    <div id="jdLoading" class="text-center py-12">
        <i class="fas fa-spinner fa-spin text-3xl text-red-500"></i>
        <p class="text-gray-500 mt-3">Loading JD details...</p>
    </div>

    <!-- Content (hidden until loaded) -->
    <div id="jdContent" class="hidden">
        <!-- Form Title -->
        <div class="bg-white rounded-xl shadow-sm p-4 md:p-6 text-center mb-6">
            <h2 class="text-lg font-semibold">Campus Placement Registration Form</h2>
            <p class="text-gray-500 text-sm">RK University, Rajkot – Training &amp; Placement Cell</p>
        </div>

        <!-- Contact Information -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm">
                    <i class="fas fa-address-book"></i>
                </div>
                <h2 class="text-md font-semibold text-gray-700">Contact Information</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div class="bg-gray-100 p-4 rounded-lg"><p class="font-semibold">Dr. Vishal Doshi</p><p class="text-sm text-gray-600">Head of Training &amp; Placement Cell</p><p class="text-sm">+91 98765 43210</p></div>
                <div class="bg-gray-100 p-4 rounded-lg"><p class="font-semibold">Mr. Osho Shah</p><p class="text-sm text-gray-600">Assistant Training &amp; Placement Officer</p><p class="text-sm">+91 87654 32109</p></div>
            </div>
        </div>

        <!-- Company Details -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm"><i class="fas fa-building"></i></div>
                <h2 class="text-md font-semibold text-gray-700">Company Details</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Email Address *</label><input type="email" id="jdCompEmail" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Name *</label><input type="text" id="jdCompanyName" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Job Location *</label><input type="text" id="jdJobLocation" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Website URL *</label><input type="text" id="jdWebsite" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div class="md:col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Company Description</label><textarea id="jdDescription" rows="4" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500"></textarea></div>
            </div>
        </div>

        <!-- Job Role -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm"><i class="fas fa-briefcase"></i></div>
                <h2 class="text-md font-semibold text-gray-700">Job Role &amp; Compensation</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Job Position</label><input type="text" id="jdJobPosition" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Annual CTC</label><input type="text" id="jdAnnualCTC" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Internship Duration</label><input type="text" id="jdInternshipDuration" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Stipend During Internship</label><input type="text" id="jdStipend" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Bond</label><input type="text" id="jdBond" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Date of Joining</label><input type="date" id="jdDateOfJoining" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
            </div>
        </div>

        <!-- Eligibility -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm"><i class="fas fa-check-circle"></i></div>
                <h2 class="text-md font-semibold text-gray-700">Eligibility Criteria</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="font-semibold text-sm mb-2">Eligible Batch</p>
                    <div id="jdBatchContainer" class="flex flex-wrap gap-3">
                        @foreach (var b in new[] { "2025", "2024", "2023" }) {
                            <label class="flex items-center gap-2"><input type="checkbox" value="@b" name="jdBatch" disabled class="jd-editable" /> @b</label>
                        }
                    </div>
                </div>
                <div>
                    <p class="font-semibold text-sm mb-2">Eligible Courses</p>
                    <div id="jdCourseContainer" class="flex flex-wrap gap-3">
                        @foreach (var c in new[] { "B.Tech CS", "B.Tech IT", "Mechanical", "Civil", "Electrical", "BCA", "MCA", "MBA" }) {
                            <label class="flex items-center gap-2"><input type="checkbox" value="@c" name="jdCourse" disabled class="jd-editable" /> @c</label>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Selection Process -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm"><i class="fas fa-clipboard-list"></i></div>
                <h2 class="text-md font-semibold text-gray-700">Selection Process</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2"><textarea id="jdSelectionProcess" rows="3" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500"></textarea></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Expected Date of Campus Drive</label><input type="date" id="jdCampusDriveDate" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Registration Link (Optional)</label><input type="text" id="jdRegistrationLink" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
            </div>
        </div>

        <!-- Contact Person -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm"><i class="fas fa-user-tie"></i></div>
                <h2 class="text-md font-semibold text-gray-700">Contact Person Details</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact Person Name</label><input type="text" id="jdContactName" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact Person Email ID</label><input type="text" id="jdContactEmail" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact Person Mobile No</label><input type="text" id="jdContactMobile" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500" /></div>
            </div>
        </div>

        <!-- Additional Details -->
        <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="bg-red-600 text-white w-7 h-7 flex items-center justify-center rounded-full text-sm"><i class="fas fa-clipboard-list"></i></div>
                <h2 class="text-md font-semibold text-gray-700">Additional Details</h2>
            </div>
            <textarea id="jdAdditionalNotes" rows="4" readonly class="jd-editable w-full border rounded-lg p-3 outline-none bg-gray-100 text-gray-500"></textarea>
        </div>

        <!-- Save/Cancel Buttons -->
        <div id="jdSaveArea" class="flex flex-col-reverse md:flex-row justify-end gap-4 mt-6 hidden">
            <button onclick="cancelJdEdit()" class="border px-6 py-2 rounded-lg hover:bg-gray-50 w-full md:w-auto bg-white cursor-pointer">CANCEL</button>
            <button onclick="saveJdChangesApi()" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 w-full md:w-auto border-none cursor-pointer">Save Changes</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let currentJdId = null;

document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Admin')) return;

    const params = new URLSearchParams(window.location.search);
    currentJdId = params.get('id');
    if (!currentJdId) {
        window.location.href = '/Admin/CompanyManagement';
        return;
    }
    loadJdDetail(currentJdId);
});

async function loadJdDetail(id) {
    const loading = document.getElementById('jdLoading');
    const content = document.getElementById('jdContent');

    try {
        const res = await authFetch(`/api/company/job-postings/${id}`);
        const result = await res.json();

        loading.classList.add('hidden');

        if (!result.success || !result.data) {
            alert('JD not found.');
            window.location.href = '/Admin/CompanyManagement';
            return;
        }

        const jp = result.data;

        // Populate fields
        document.getElementById('jdCompEmail').value = jp.companyEmail || '';
        document.getElementById('jdCompanyName').value = jp.companyName || '';
        document.getElementById('jdJobLocation').value = jp.jobLocation || '';
        document.getElementById('jdWebsite').value = jp.website || '';
        document.getElementById('jdDescription').value = jp.description || '';
        document.getElementById('jdJobPosition').value = jp.jobPosition || '';
        document.getElementById('jdAnnualCTC').value = jp.annualCTC || '';
        document.getElementById('jdInternshipDuration').value = jp.internshipDuration || '';
        document.getElementById('jdStipend').value = jp.stipend || '';
        document.getElementById('jdBond').value = jp.bond || '';
        document.getElementById('jdDateOfJoining').value = jp.dateOfJoining ? jp.dateOfJoining.split('T')[0] : '';
        document.getElementById('jdSelectionProcess').value = jp.selectionProcess || '';
        document.getElementById('jdCampusDriveDate').value = jp.campusDriveDate ? jp.campusDriveDate.split('T')[0] : '';
        document.getElementById('jdRegistrationLink').value = jp.registrationLink || '';
        document.getElementById('jdContactName').value = jp.contactName || '';
        document.getElementById('jdContactEmail').value = jp.contactEmail || '';
        document.getElementById('jdContactMobile').value = jp.contactMobile || '';
        document.getElementById('jdAdditionalNotes').value = jp.additionalNotes || '';

        // Set checkboxes for batches
        const batches = (jp.eligibleBatches || '').split(',').map(b => b.trim());
        document.querySelectorAll('input[name="jdBatch"]').forEach(cb => {
            cb.checked = batches.includes(cb.value);
        });

        // Set checkboxes for courses
        const courses = (jp.eligibleCourses || '').split(',').map(c => c.trim());
        document.querySelectorAll('input[name="jdCourse"]').forEach(cb => {
            cb.checked = courses.includes(cb.value);
        });

        content.classList.remove('hidden');

    } catch (err) {
        loading.classList.add('hidden');
        alert('Failed to load JD details.');
        console.error(err);
    }
}

async function saveJdChangesApi() {
    if (!currentJdId) return;

    const batches = Array.from(document.querySelectorAll('input[name="jdBatch"]:checked')).map(cb => cb.value).join(',');
    const courses = Array.from(document.querySelectorAll('input[name="jdCourse"]:checked')).map(cb => cb.value).join(',');

    const payload = {
        companyName: document.getElementById('jdCompanyName').value,
        email: document.getElementById('jdCompEmail').value,
        website: document.getElementById('jdWebsite').value,
        jobLocation: document.getElementById('jdJobLocation').value,
        description: document.getElementById('jdDescription').value,
        jobPosition: document.getElementById('jdJobPosition').value,
        annualCTC: document.getElementById('jdAnnualCTC').value,
        internshipDuration: document.getElementById('jdInternshipDuration').value,
        stipend: document.getElementById('jdStipend').value,
        bond: document.getElementById('jdBond').value,
        dateOfJoining: document.getElementById('jdDateOfJoining').value,
        eligibleBatches: batches,
        eligibleCourses: courses,
        selectionProcess: document.getElementById('jdSelectionProcess').value,
        campusDriveDate: document.getElementById('jdCampusDriveDate').value,
        registrationLink: document.getElementById('jdRegistrationLink').value,
        additionalNotes: document.getElementById('jdAdditionalNotes').value,
        contactName: document.getElementById('jdContactName').value,
        contactEmail: document.getElementById('jdContactEmail').value,
        contactMobile: document.getElementById('jdContactMobile').value
    };

    try {
        const res = await authFetch(`/api/company/job-postings/${currentJdId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const result = await res.json();

        if (result.success) {
            alert('JD changes saved successfully!');
            cancelJdEdit();
        } else {
            alert(result.message || 'Failed to save changes.');
        }
    } catch (err) {
        alert('Network error. Please try again.');
        console.error(err);
    }
}
</script>
}
