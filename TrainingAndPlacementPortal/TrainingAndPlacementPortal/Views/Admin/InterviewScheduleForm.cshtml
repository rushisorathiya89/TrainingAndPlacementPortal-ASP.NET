@{ ViewData["Title"] = "Interview Schedule Form"; }

<div class="w-full">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 md:gap-0 relative z-10">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-red-600">Interview Schedule Form</h1>
            <p class="text-gray-600 text-sm md:text-base">Manage interview Rounds.</p>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <button type="button" onclick="history.back()" class="border px-5 py-2 rounded-lg w-full md:w-auto bg-white cursor-pointer hover:bg-gray-50 text-gray-800">
                ← Back
            </button>
        </div>
    </div>

    <!-- Job Selection Card -->
    <div class="bg-[#d1c2b5] p-6 md:p-8 rounded-2xl shadow-sm mb-6 border border-[#c4b5a6]">
        <h2 class="text-lg font-bold mb-6 m-0 uppercase tracking-tight">Select Job Drive</h2>
        <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Approved Job Posting *</label>
                <select id="jobPostingSelect" class="w-full p-4 rounded-xl border bg-white outline-none focus:ring-2 focus:ring-blue-500 font-medium">
                    <option value="">-- Select an Approved Job Drive --</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Rounds Cards Container -->
    <div id="roundsContainer">
        <!-- Initial Round Card -->
        <div class="round-card bg-[#d1c2b5] p-6 md:p-8 rounded-2xl shadow-sm mb-6 relative border border-[#c4b5a6]">
            <div class="flex justify-between items-center mb-6">
                <h2 class="round-title text-lg font-bold m-0 uppercase tracking-tight">Round 1 Details</h2>
                <button type="button" onclick="deleteRound(this)" class="delete-round-btn text-red-600 hover:text-red-800 p-2 rounded-xl hover:bg-red-100 transition-colors hidden cursor-pointer border-none bg-transparent" title="Delete Round">
                    <i class="fas fa-trash-alt text-lg"></i>
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Round No</label>
                    <input type="number" class="round-number w-full p-4 rounded-xl border outline-none bg-white font-medium" value="1" readonly />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Round Name *</label>
                    <input type="text" placeholder="e.g. Aptitude Test" class="round-name w-full p-4 rounded-xl border outline-none bg-white font-medium" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Interview Type *</label>
                    <select class="interview-type w-full p-4 rounded-xl border outline-none bg-white font-medium">
                        <option value="Offline">Offline</option>
                        <option value="Online">Online</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Venue / Link *</label>
                    <input type="text" placeholder="e.g. Lab 1 or Meet Link" class="location-link w-full p-4 rounded-xl border outline-none bg-white font-medium" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Date *</label>
                    <input type="date" class="interview-date w-full p-4 rounded-xl border outline-none bg-white font-medium" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Timing *</label>
                    <input type="time" class="interview-time w-full p-4 rounded-xl border outline-none bg-white font-medium" required />
                </div>
                <div class="md:col-span-1">
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Waiting Area</label>
                    <input type="text" placeholder="e.g. Seminar Hall" class="waiting-area w-full p-4 rounded-xl border outline-none bg-white font-medium" />
                </div>
                <div class="md:col-span-1">
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-2">Special Instructions</label>
                    <input type="text" placeholder="e.g. Bring your own laptop" class="instructions w-full p-4 rounded-xl border outline-none bg-white font-medium" />
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mt-8 pb-12">
        <button type="button" onclick="addRound()" class="bg-[#2563eb] text-white px-8 py-4 rounded-xl hover:bg-blue-700 w-full md:w-auto cursor-pointer border-none transition-all font-bold text-sm uppercase shadow-sm active:scale-[0.98]">
            + Add Another Round
        </button>
        <button type="button" onclick="submitInterviewSchedule()" class="bg-[#e7000b] text-white px-8 py-4 rounded-xl hover:bg-red-700 w-full md:w-auto cursor-pointer border-none transition-all font-bold text-sm uppercase shadow-sm active:scale-[0.98]">
            Schedule Interviews
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Admin')) return;
            await loadApprovedJobs();

            // Check if we are in 'Edit' mode
            const urlParams = new URLSearchParams(window.location.search);
            const jobId = urlParams.get('jobId');
            if (jobId) {
                document.getElementById('jobPostingSelect').value = jobId;
                await loadExistingSchedules(jobId);
            }
        });

        async function loadExistingSchedules(jobId) {
            try {
                const res = await authFetch('/api/admin/interview-schedules');
                if (!res || !res.ok) return;
                const result = await res.json();
                
                if (result.success) {
                    const existing = result.data.filter(s => s.jobPostingId == jobId);
                    if (existing.length > 0) {
                        // Clear container first
                        const container = document.getElementById('roundsContainer');
                        container.innerHTML = '';
                        
                        existing.forEach((iv, index) => {
                            addRound();
                            const cards = document.querySelectorAll('.round-card');
                            const card = cards[index];
                            
                            card.querySelector('.round-name').value = iv.roundName;
                            card.querySelector('.interview-type').value = iv.interviewType;
                            card.querySelector('.location-link').value = iv.locationOrLink;
                            card.querySelector('.waiting-area').value = iv.waitingArea || '';
                            card.querySelector('.instructions').value = iv.instructions || '';
                            
                            // Handle date and time
                            const dt = new Date(iv.interviewDate);
                            card.querySelector('.interview-date').value = dt.toISOString().split('T')[0];
                            card.querySelector('.interview-time').value = dt.toTimeString().slice(0, 5);
                        });
                        updateRoundNumbers();
                    }
                }
            } catch (err) {
                console.error('Error loading existing schedules:', err);
            }
        }

        async function loadApprovedJobs() {
            try {
                // Use the new endpoint that filters Approved + Has Applications
                const res = await authFetch('/api/company/admin/schedulable-jobs');
                if (!res || !res.ok) throw new Error('Failed to load eligible jobs');
                const result = await res.json();
                
                if (result.success) {
                    const select = document.getElementById('jobPostingSelect');
                    select.innerHTML = '<option value="">-- Select an Eligible Job Drive --</option>';
                    
                    if (result.data.length === 0) {
                        const option = document.createElement('option');
                        option.disabled = true;
                        option.textContent = "No approved jobs with applications found.";
                        select.appendChild(option);
                        return;
                    }

                    result.data.forEach(job => {
                        const option = document.createElement('option');
                        option.value = job.id;
                        option.textContent = `${job.companyName} - ${job.jobRole} (${job.package}) [${job.applicationCount} Applied]`;
                        select.appendChild(option);
                    });
                }
            } catch (err) {
                console.error(err);
                alert('Error loading job drives. Only approved jobs with applications can be scheduled.');
            }
        }

        function updateRoundNumbers() {
            const cards = document.querySelectorAll('.round-card');
            const deleteBtns = document.querySelectorAll('.delete-round-btn');
            
            cards.forEach((card, index) => {
                const num = index + 1;
                card.querySelector('.round-title').innerText = `Round ${num} Details`;
                card.querySelector('.round-number').value = num;
            });

            if (cards.length > 1) {
                deleteBtns.forEach(btn => btn.classList.remove('hidden'));
            } else {
                deleteBtns.forEach(btn => btn.classList.add('hidden'));
            }
        }

        function addRound() {
            const container = document.getElementById('roundsContainer');
            const template = container.querySelector('.round-card').cloneNode(true);
            
            template.querySelectorAll('input').forEach(input => {
                if (!input.classList.contains('round-number')) input.value = '';
            });
            
            container.appendChild(template);
            updateRoundNumbers();
        }

        function deleteRound(btn) {
            const card = btn.closest('.round-card');
            card.remove();
            updateRoundNumbers();
        }

        async function submitInterviewSchedule() {
            const jobPostingId = document.getElementById('jobPostingSelect').value;
            if (!jobPostingId) {
                alert('Please select a Job Drive first.');
                return;
            }

            const roundCards = document.querySelectorAll('.round-card');
            const schedules = [];

            for (const card of roundCards) {
                const roundName = card.querySelector('.round-name').value;
                const date = card.querySelector('.interview-date').value;
                const time = card.querySelector('.interview-time').value;
                const location = card.querySelector('.location-link').value;

                if (!roundName || !date || !time || !location) {
                    alert('Please fill out all required fields for each round.');
                    return;
                }

                schedules.push({
                    jobPostingId: parseInt(jobPostingId),
                    roundNumber: parseInt(card.querySelector('.round-number').value),
                    roundName: roundName,
                    interviewType: card.querySelector('.interview-type').value,
                    locationOrLink: location,
                    interviewDate: `${date}T${time}:00`,
                    waitingArea: card.querySelector('.waiting-area').value,
                    instructions: card.querySelector('.instructions').value,
                    status: 'Pending'
                });
            }

            try {
                const btn = document.querySelector('button[onclick="submitInterviewSchedule()"]');
                const originalText = btn.textContent;
                btn.textContent = 'Scheduling...';
                btn.disabled = true;

                const res = await authFetch('/api/admin/interview-schedules', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(schedules)
                });

                const result = await res.json();
                if (result.success) {
                    alert(result.message);
                    window.location.href = '/AdminInterviewSchedule';
                } else {
                    // Show detailed error if available
                    let errMsg = result.message || 'Failed to schedule interviews';
                    if (result.error) errMsg += `\nError: ${result.error}`;
                    
                    // Robust check for array of errors (standard ASP.NET Core validation)
                    if (result.errors) {
                        if (Array.isArray(result.errors)) {
                            errMsg += `\nDetails: ${result.errors.join(', ')}`;
                        } else if (typeof result.errors === 'object') {
                            const details = Object.values(result.errors).flat().join(', ');
                            errMsg += `\nDetails: ${details}`;
                        }
                    }
                    
                    alert(errMsg);
                    btn.textContent = originalText;
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred during submission. Please check your data and try again.');
                const btn = document.querySelector('button[onclick="submitInterviewSchedule()"]');
                btn.textContent = 'Schedule Interviews';
                btn.disabled = false;
            }
        }
    </script>
}
