        async function submitInterviewSchedule() {
            const jobPostingId = document.getElementById('jobPostingSelect').value;
            if (!jobPostingId) {
                alert('Please select a Job Drive first.');
                return;
            }

            const roundCards = document.querySelectorAll('.round-card');
            const schedules = [];

            for (const card of roundCards) {
                const roundName = card.querySelector('.round-name').value;
                const date = card.querySelector('.interview-date').value;
                const time = card.querySelector('.interview-time').value;
                const location = card.querySelector('.location-link').value;

                if (!roundName || !date || !time || !location) {
                    alert('Please fill out all required fields for each round.');
                    return;
                }

                schedules.push({
                    jobPostingId: parseInt(jobPostingId),
                    roundNumber: parseInt(card.querySelector('.round-number').value),
                    roundName: roundName,
                    interviewType: card.querySelector('.interview-type').value,
                    locationOrLink: location,
                    interviewDate: `${date}T${time}:00`,
                    waitingArea: card.querySelector('.waiting-area').value,
                    instructions: card.querySelector('.instructions').value,
                    status: 'Pending'
                });
            }

            try {
                const btn = document.querySelector('button[onclick="submitInterviewSchedule()"]');
                const originalText = btn.textContent;
                btn.textContent = 'Scheduling...';
                btn.disabled = true;

                const res = await authFetch('/api/admin/interview-schedules', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(schedules)
                });

                const result = await res.json();
                if (result.success) {
                    alert(result.message);
                    window.location.href = '/AdminInterviewSchedule';
                } else {
                    // Show detailed error if available
                    let errMsg = result.message || 'Failed to schedule interviews';
                    if (result.error) errMsg += `\nError: ${result.error}`;
                    
                    // Robust check for array of errors (standard ASP.NET Core validation)
                    if (result.errors) {
                        if (Array.isArray(result.errors)) {
                            errMsg += `\nDetails: ${result.errors.join(', ')}`;
                        } else if (typeof result.errors === 'object') {
                            const details = Object.values(result.errors).flat().join(', ');
                            errMsg += `\nDetails: ${details}`;
                        }
                    }
                    
                    alert(errMsg);
                    btn.textContent = originalText;
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred during submission. Please check your data and try again.');
                const btn = document.querySelector('button[onclick="submitInterviewSchedule()"]');
                btn.textContent = 'Schedule Interviews';
                btn.disabled = false;
            }
        }
