@{ ViewData["Title"] = "Interview Schedule Form"; }

<div class="w-full">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 md:gap-0 relative z-10">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-red-600">Interview Schedule Form</h1>
            <p class="text-gray-600 text-sm md:text-base">Manage interview Rounds.</p>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <button type="button" onclick="history.back()" class="border px-5 py-2 rounded-lg w-full md:w-auto bg-white cursor-pointer hover:bg-gray-50 text-gray-800">
                ← Back
            </button>
        </div>
    </div>

    <!-- Company Details Card -->
    <div class="bg-[#d8cfc3] p-6 md:p-8 rounded-xl shadow-md mb-6">
        <h2 class="text-lg font-semibold mb-6 m-0">Company Details</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm mb-1">Company Name</label>
                <input type="text" id="schedCompanyName" readonly class="w-full p-3 rounded-lg border outline-none bg-gray-100" />
            </div>
            <div>
                <label class="block text-sm mb-1">HR Name</label>
                <input type="text" id="schedHrName" readonly class="w-full p-3 rounded-lg border outline-none bg-gray-100" />
            </div>
        </div>
    </div>

    <!-- Rounds Cards Container -->
    <div id="roundsContainer">
        <!-- Initial Round Card -->
        <div class="round-card bg-[#d8cfc3] p-6 md:p-8 rounded-xl shadow-md mb-6 relative">
            <div class="flex justify-between items-center mb-6">
                <h2 class="round-title text-lg font-semibold m-0">Round 1 Details</h2>
                <button type="button" onclick="deleteRound(this)" class="delete-round-btn text-red-600 hover:text-red-800 p-2 rounded-full hover:bg-red-100 transition-colors hidden cursor-pointer border-none bg-transparent" title="Delete Round">
                    <i class="fas fa-trash-alt text-lg"></i>
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm mb-1">Round No</label>
                    <input type="text" name="roundNo" placeholder="e.g. 1" class="w-full p-3 rounded-lg border outline-none bg-white" />
                </div>
                <div>
                    <label class="block text-sm mb-1">Round Name</label>
                    <input type="text" name="roundName" placeholder="e.g. Aptitude Test" class="w-full p-3 rounded-lg border outline-none bg-white" />
                </div>
                <div>
                    <label class="block text-sm mb-1">Venue</label>
                    <input type="text" name="venue" placeholder="e.g. Panel No. 2" class="w-full p-3 rounded-lg border outline-none bg-white" />
                </div>
                <div>
                    <label class="block text-sm mb-1">Waiting Area</label>
                    <input type="text" name="waitingArea" placeholder="e.g. Krishna Murti hall" class="w-full p-3 rounded-lg border outline-none bg-white" />
                </div>
                <div>
                    <label class="block text-sm mb-1">Date</label>
                    <input type="date" name="date" class="w-full p-3 rounded-lg border outline-none bg-white" />
                </div>
                <div>
                    <label class="block text-sm mb-1">Timing</label>
                    <input type="time" name="timing" class="w-full p-3 rounded-lg border outline-none bg-white" />
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mt-8 pb-8">
        <button type="button" onclick="addRound()" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 w-full md:w-auto cursor-pointer border-none transition font-semibold text-base">
            Schedule Another Round
        </button>
        <button type="button" onclick="submitInterviewSchedule()" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 w-full md:w-auto cursor-pointer border-none transition font-semibold text-base">
            Submit
        </button>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (!requireAuth('Admin')) return;
        
        const params = new URLSearchParams(window.location.search);
        const jobId = params.get('jobId');
        if (jobId) {
            loadCompanyInfo(jobId);
        }
    });

    async function loadCompanyInfo(jobId) {
        try {
            const res = await authFetch(`/api/company/job-postings/${jobId}`);
            const result = await res.json();
            if (result.success && result.data) {
                document.getElementById('schedCompanyName').value = result.data.companyName;
                document.getElementById('schedHrName').value = result.data.contactName || 'TPO Representative';
            }
            
            // Also load existing rounds if any
            loadExistingRounds(jobId);
        } catch (err) {
            console.error('Failed to load company info:', err);
        }
    }

    async function loadExistingRounds(jobId) {
        try {
            const res = await authFetch(`/api/admin/interview-schedules/${jobId}`);
            const result = await res.json();
            
            if (result.success && result.data && result.data.length > 0) {
                const container = document.getElementById('roundsContainer');
                container.innerHTML = ''; // Start fresh
                
                result.data.forEach((r, idx) => {
                    addRound(r);
                });
            }
        } catch (err) {
            console.error('Failed to load rounds:', err);
        }
    }

    function updateRoundNumbers() {
        const cards = document.querySelectorAll('.round-card');
        const deleteBtns = document.querySelectorAll('.delete-round-btn');
        
        cards.forEach((card, index) => {
            card.querySelector('.round-title').innerText = `Round ${index + 1} Details`;
        });

        // Hide delete button if only 1 round left
        if (cards.length > 1) {
            deleteBtns.forEach(btn => btn.classList.remove('hidden'));
        } else {
            deleteBtns.forEach(btn => btn.classList.add('hidden'));
        }
    }

    function addRound(data = null) {
        const container = document.getElementById('roundsContainer');
        const cards = container.querySelectorAll('.round-card');
        
        // Use first card as template if exists, else we need the HTML
        let template;
        if (cards.length > 0) {
            template = cards[0].cloneNode(true);
        } else {
            // Re-create the HTML if container was empty
            const div = document.createElement('div');
            div.innerHTML = `
                <div class="round-card bg-[#d8cfc3] p-6 md:p-8 rounded-xl shadow-md mb-6 relative">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="round-title text-lg font-semibold m-0">Round Details</h2>
                        <button type="button" onclick="deleteRound(this)" class="delete-round-btn text-red-600 hover:text-red-800 p-2 rounded-full hover:bg-red-100 transition-colors hidden cursor-pointer border-none bg-transparent" title="Delete Round">
                            <i class="fas fa-trash-alt text-lg"></i>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm mb-1">Round No</label>
                            <input type="text" name="roundNo" placeholder="e.g. 1" class="w-full p-3 rounded-lg border outline-none bg-white" />
                        </div>
                        <div>
                            <label class="block text-sm mb-1">Round Name</label>
                            <input type="text" name="roundName" placeholder="e.g. Aptitude Test" class="w-full p-3 rounded-lg border outline-none bg-white" />
                        </div>
                        <div>
                            <label class="block text-sm mb-1">Venue</label>
                            <input type="text" name="venue" placeholder="e.g. Panel No. 2" class="w-full p-3 rounded-lg border outline-none bg-white" />
                        </div>
                        <div>
                            <label class="block text-sm mb-1">Waiting Area</label>
                            <input type="text" name="waitingArea" placeholder="e.g. Krishna Murti hall" class="w-full p-3 rounded-lg border outline-none bg-white" />
                        </div>
                        <div>
                            <label class="block text-sm mb-1">Date</label>
                            <input type="date" name="date" class="w-full p-3 rounded-lg border outline-none bg-white" />
                        </div>
                        <div>
                            <label class="block text-sm mb-1">Timing</label>
                            <input type="time" name="timing" class="w-full p-3 rounded-lg border outline-none bg-white" />
                        </div>
                    </div>
                </div>
            `;
            template = div.firstElementChild;
        }
        
        // Clear or populate inputs
        template.querySelector('input[name="roundNo"]').value = data ? data.roundNumber : (cards.length + 1);
        template.querySelector('input[name="roundName"]').value = data ? data.roundName : '';
        template.querySelector('input[name="venue"]').value = data ? data.venue : '';
        template.querySelector('input[name="waitingArea"]').value = data ? data.waitingArea : '';
        template.querySelector('input[name="date"]').value = data ? data.interviewDate.split('T')[0] : '';
        template.querySelector('input[name="timing"]').value = data ? data.timing : '';
        
        container.appendChild(template);
        updateRoundNumbers();
    }

    function deleteRound(btn) {
        const card = btn.closest('.round-card');
        card.remove();
        updateRoundNumbers();
    }

    async function submitInterviewSchedule() {
        const jobId = new URLSearchParams(window.location.search).get('jobId');
        if (!jobId) return;

        const roundCards = document.querySelectorAll('.round-card');
        const rounds = [];

        roundCards.forEach(card => {
            rounds.push({
                roundNumber: parseInt(card.querySelector('input[name="roundNo"]').value) || 0,
                roundName: card.querySelector('input[name="roundName"]').value,
                venue: card.querySelector('input[name="venue"]').value,
                waitingArea: card.querySelector('input[name="waitingArea"]').value,
                interviewDate: card.querySelector('input[name="date"]').value,
                timing: card.querySelector('input[name="timing"]').value
            });
        });

        if (rounds.length === 0) {
            alert('Please add at least one round.');
            return;
        }

        try {
            const res = await authFetch(`/api/admin/interview-schedules/${jobId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(rounds)
            });
            const result = await res.json();
            
            if (result.success) {
                alert('Interview Schedule saved successfully!');
                window.location.href = '/Admin/InterviewSchedule';
            } else {
                alert(result.message || 'Failed to save schedule.');
            }
        } catch (err) {
            alert('Network error. Please try again.');
        }
    }
</script>
}
