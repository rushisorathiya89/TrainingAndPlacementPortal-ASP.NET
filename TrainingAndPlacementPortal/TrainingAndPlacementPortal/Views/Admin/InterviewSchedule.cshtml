@{ ViewData["Title"] = "Interview Schedule"; }

<div class="w-full">
    <h1 class="text-2xl md:text-3xl font-bold text-red-600">Interview Schedule</h1>
    <p class="text-gray-600 mb-6 md:mb-8 text-sm md:text-base">Manage interview schedules.</p>

    <!-- Search and Filter -->
    <div class="mb-6 flex flex-col md:flex-row gap-4 items-stretch md:items-center">
        <div class="relative flex-grow w-full">
            <input type="text" id="searchInput" placeholder="Search by company, role, location, or salary" oninput="filterCards()" class="w-full p-3 pl-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300" />
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>
        <div class="relative w-full md:w-48 flex-shrink-0">
            <select id="searchCategory" onchange="filterCards()" class="w-full appearance-none p-3 pr-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300 cursor-pointer text-gray-700 shadow-sm">
                <option value="All">All Categories</option>
                <option value="Company">Company Name</option>
                <option value="Role">Job Role</option>
                <option value="Location">Location</option>
                <option value="Salary">Salary</option>
            </select>
            <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
        </div>
        <div class="relative w-full md:w-72 flex-shrink-0">
            <select id="filterStatus" onchange="filterCards()" class="w-full appearance-none p-3 pr-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300 cursor-pointer text-gray-700 shadow-sm">
                <option value="All">All Status</option>
                <option value="On Hold">On Hold</option>
                <option value="Scheduled Interview (Pending)">Scheduled Interview (Pending)</option>
                <option value="Scheduled Interview (Complete)">Scheduled Interview (Complete)</option>
            </select>
            <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
        </div>
    </div>

    <!-- Cards Container -->
    <div id="interviewCards" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
        <div class="col-span-full py-12 text-center text-gray-400">Loading interview schedules...</div>
    </div>
</div>

@section Scripts {
    <script>
        let allSchedules = [];

        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Admin')) return;
            await loadSchedules();
        });

        async function loadSchedules() {
            try {
                const res = await authFetch('/api/admin/interview-schedules');
                if (!res || !res.ok) throw new Error('Failed to fetch schedules');
                const result = await res.json();
                
                if (result.success) {
                    allSchedules = result.data;
                    renderSchedules(allSchedules);
                }
            } catch (err) {
                console.error(err);
                document.getElementById('interviewCards').innerHTML = '<p class="text-red-500 col-span-full">Failed to load interview schedules.</p>';
            }
        }

        function renderSchedules(schedules) {
            const container = document.getElementById('interviewCards');
            if (schedules.length === 0) {
                container.innerHTML = '<p class="text-gray-500 col-span-full py-12 bg-white rounded-xl shadow text-center">No interviews scheduled yet.</p>';
                return;
            }

            let html = '';
            schedules.forEach(iv => {
                const firstLetter = iv.companyName ? iv.companyName.charAt(0).toUpperCase() : 'C';
                const date = new Date(iv.interviewDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
                const time = new Date(iv.interviewDate).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                const statusColor = iv.status === 'Complete' ? 'bg-green-100 text-green-700' : (iv.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : 'bg-gray-100 text-gray-700');

                html += `
                <div class="filterable-card bg-[#d1c2b5] p-6 rounded-2xl shadow-sm border border-[#c4b5a6] transition-all hover:shadow-md" 
                     data-name="${iv.companyName}" data-role="${iv.jobRole}" data-location="${iv.locationOrLink}" data-status="${iv.status}">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-[#2563eb] rounded-xl flex items-center justify-center text-white font-bold text-2xl shrink-0 shadow-sm">${firstLetter}</div>
                            <div>
                                <h3 class="text-lg font-bold text-gray-900 m-0">${iv.companyName}</h3>
                                <p class="text-gray-600 text-sm font-semibold m-0">${iv.jobRole}</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider ${statusColor}">${iv.status}</span>
                    </div>

                    <div class="text-[#e7000b] text-xl font-extrabold mb-4 tracking-tight">${iv.annualCTC || 'N/A'}</div>
                    
                    <div class="space-y-3 mb-6">
                        <div class="flex items-center gap-2 text-gray-700 text-sm font-medium">
                            <i class="fas fa-calendar-alt text-gray-400 w-4"></i>
                            <span>${date} at ${time}</span>
                        </div>
                        <div class="flex items-center gap-2 text-gray-700 text-sm font-medium">
                            <i class="fas fa-map-marker-alt text-gray-400 w-4"></i>
                            <span class="truncate">${iv.locationOrLink}</span>
                        </div>
                        <div class="inline-block px-3 py-1 bg-white/50 rounded-lg border border-gray-300">
                             <span class="text-gray-800 text-xs font-bold uppercase">Round ${iv.roundNumber}: ${iv.roundName}</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 mt-auto pt-4 border-t border-gray-400/30">
                        <button onclick="updateScheduleStatus(${iv.id}, 'On Hold')" class="bg-[#d8cfc3] hover:bg-gray-300 text-gray-700 py-2.5 rounded-xl font-bold text-xs uppercase border border-gray-400 transition-colors">
                            ON HOLD
                        </button>
                        <button onclick="updateScheduleStatus(${iv.id}, 'Complete')" class="bg-[#2563eb] hover:bg-blue-700 text-white py-2.5 rounded-xl font-bold text-xs uppercase border-none transition-colors">
                            MARK COMPLETE
                        </button>
                    </div>
                </div>`;
            });

            container.innerHTML = html;
        }

        async function updateScheduleStatus(id, status) {
            // Simplified status update logic
            alert('Updating status to: ' + status);
        }

        function filterCards() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const category = document.getElementById('searchCategory').value;
            const status = document.getElementById('filterStatus').value;
            
            const filtered = allSchedules.filter(iv => {
                const matchesSearch = category === 'All' ? 
                    (iv.companyName.toLowerCase().includes(query) || iv.jobRole.toLowerCase().includes(query)) :
                    (category === 'Company' ? iv.companyName.toLowerCase().includes(query) : iv.jobRole.toLowerCase().includes(query));
                
                const matchesStatus = status === 'All' || iv.status === status || (status === 'Scheduled Interview (Pending)' && iv.status === 'Pending');
                return matchesSearch && matchesStatus;
            });

            renderSchedules(filtered);
        }
    </script>
}
