@{ ViewData["Title"] = "Interview Schedule"; }

<div class="w-full">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-red-600">Interview Schedule</h1>
            <p class="text-gray-600 text-sm md:text-base">Manage and track interview rounds for job drives.</p>
        </div>
        <a href="/AdminInterviewScheduleForm" class="bg-[#e7000b] text-white px-6 py-3 rounded-xl hover:bg-red-700 transition-all font-bold text-sm uppercase shadow-sm no-underline flex items-center gap-2">
            <i class="fas fa-plus"></i> Schedule New Interview
        </a>
    </div>

    <!-- Search and Filter -->
    <div class="mb-6 flex flex-col md:flex-row gap-4 items-stretch md:items-center">
        <div class="relative flex-grow w-full">
            <input type="text" id="searchInput" placeholder="Search by company, role, location, or salary" oninput="filterCards()" class="w-full p-3 pl-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300" />
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>
        <div class="relative w-full md:w-48 flex-shrink-0">
            <select id="searchCategory" onchange="filterCards()" class="w-full appearance-none p-3 pr-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300 cursor-pointer text-gray-700 shadow-sm">
                <option value="All">All Categories</option>
                <option value="Company">Company Name</option>
                <option value="Role">Job Role</option>
                <option value="Location">Location</option>
                <option value="Salary">Salary</option>
            </select>
            <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
        </div>
        <div class="relative w-full md:w-72 flex-shrink-0">
            <select id="filterStatus" onchange="filterCards()" class="w-full appearance-none p-3 pr-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300 cursor-pointer text-gray-700 shadow-sm">
                <option value="All">All Status</option>
                <option value="On Hold">On Hold</option>
                <option value="Scheduled Interview (Pending)">Scheduled Interview (Pending)</option>
                <option value="Scheduled Interview (Complete)">Scheduled Interview (Complete)</option>
            </select>
            <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
        </div>
    </div>

    <!-- Cards -->
    <div id="loading" class="text-center py-12">
        <i class="fas fa-spinner fa-spin text-3xl text-red-500"></i>
        <p class="text-gray-500 mt-3">Loading schedules...</p>
    </div>

    <div id="emptyState" class="hidden text-center py-12">
        <i class="fas fa-calendar-times text-5xl text-gray-300 mb-4"></i>
        <p class="text-gray-500">No Job Drives available for scheduling.</p>
    </div>

    <div id="scheduleContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6 hidden">
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Admin')) return;
    loadSchedules();
});

async function loadSchedules() {
    const loading = document.getElementById('loading');
    const empty = document.getElementById('emptyState');
    const container = document.getElementById('scheduleContainer');

    try {
        const res = await authFetch('/api/company/job-postings');
        const result = await res.json();

        loading.classList.add('hidden');

        if (!result.success || !result.data || result.data.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        // Only show Approved job drives for scheduling
        const approvedJobs = result.data.filter(j => j.status === 'Approved');

        if (approvedJobs.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        container.classList.remove('hidden');
        container.innerHTML = '';

        approvedJobs.forEach(iv => {
            // Determine display status based on existing data.
            // Currently, we don't have full interview rounds data from backend.
            // We default to "Scheduled Interview (Pending)" or "On Hold".
            let status = "Scheduled Interview (Pending)";
            let statusColor = "bg-yellow-100 text-yellow-700";

            // If it's a mock On Hold
            let isHold = false;

            const card = document.createElement('div');
            card.className = 'filterable-card bg-[#d8cfc3] p-6 rounded-xl shadow';
            card.dataset.name = iv.companyName || '';
            card.dataset.role = iv.jobPosition || '';
            card.dataset.location = iv.jobLocation || '';
            card.dataset.salary = iv.annualCTC || '';
            card.dataset.status = status;

            const initial = iv.companyName ? iv.companyName.charAt(0).toUpperCase() : '?';

            card.innerHTML = `
                <!-- Header -->
                <div class="flex items-center gap-4 mb-3">
                    <div class="bg-blue-600 text-white w-12 h-12 flex items-center justify-center rounded-lg text-xl font-bold">
                        ${initial}
                    </div>
                    <div>
                        <h3 class="font-bold text-lg m-0">${escapeHtml(iv.companyName)}</h3>
                        <p class="text-gray-600 text-sm m-0">${escapeHtml(iv.jobPosition)}</p>
                    </div>
                </div>

                <!-- Salary -->
                <p class="text-red-600 font-bold text-lg mb-2 m-0">${escapeHtml(iv.annualCTC)}</p>
                
                <!-- Location -->
                <p class="flex items-center gap-2 text-gray-600 text-sm mb-2 m-0">
                    <i class="fas fa-map-marker-alt"></i>${escapeHtml(iv.jobLocation || 'N/A')}
                </p>
                
                <!-- Process -->
                <p class="text-gray-600 text-sm mb-4 m-0">${escapeHtml(iv.selectionProcess || 'Not specified')}</p>

                <!-- Buttons -->
                <div class="grid grid-cols-2 gap-4">
                    <button onclick="toggleOnHold(this)" class="bg-orange-500 hover:bg-orange-600 text-white py-2 rounded cursor-pointer border-none font-semibold transition" data-hold="${isHold}">
                        ${isHold ? 'RESUME' : 'ON HOLD'}
                    </button>
                    <a href="/AdminInterviewScheduleForm?jobId=${iv.id}" class="bg-blue-600 text-white py-2 flex items-center justify-center rounded hover:bg-blue-700 cursor-pointer border-none font-semibold transition no-underline text-center text-sm md:text-base">
                        SCHEDULE INTERVIEW
                    </a>
                </div>
            `;
            container.appendChild(card);
        });

