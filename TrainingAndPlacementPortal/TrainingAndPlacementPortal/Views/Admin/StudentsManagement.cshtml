@{ ViewData["Title"] = "Students Management"; }

<div class="w-full">
    <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-red-600">Students Management</h1>
        <p class="text-gray-600 text-sm md:text-base">Manage student registrations and approvals.</p>
    </div>

    <!-- Toast Messages -->
    <div id="smToast" class="hidden fixed top-6 right-6 z-50 px-6 py-3 rounded-xl shadow-lg text-sm font-medium transition-all duration-300"></div>

    <!-- Loading State -->
    <div id="smLoading" class="text-center py-12">
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-red-600 mx-auto"></div>
        <p class="text-gray-500 mt-4">Loading students...</p>
    </div>

    <!-- Empty State -->
    <div id="smEmpty" class="hidden text-center py-12 bg-white rounded-xl shadow">
        <i class="fas fa-users text-gray-300 text-5xl mb-4"></i>
        <p class="text-gray-500 text-lg">No student registrations yet.</p>
        <p class="text-gray-400 text-sm mt-1">Students will appear here after they register on the portal.</p>
    </div>

    <!-- Students Table -->
    <div id="smTableContainer" class="hidden bg-white rounded-xl shadow overflow-x-auto">
        <div class="p-6 border-b border-[#c4b5a6] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white/30">
            <p class="text-sm font-bold text-gray-700 uppercase tracking-tight">
                 <i class="fas fa-users mr-2 text-blue-600"></i>
                 <span id="smCount" class="text-xl text-[#e7000b]">0</span> Total Registered
            </p>
            <div class="flex gap-3">
                <div class="px-4 py-2 bg-green-50 rounded-xl border border-green-200 text-green-700 text-xs font-bold shadow-sm">
                    <i class="fas fa-check-circle mr-1.5"></i>APPROVED: <span id="smApprovedCount">0</span>
                </div>
                <div class="px-4 py-2 bg-yellow-50 rounded-xl border border-yellow-200 text-yellow-700 text-xs font-bold shadow-sm">
                    <i class="fas fa-clock mr-1.5"></i>PENDING: <span id="smPendingCount">0</span>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left min-w-[1100px] border-collapse">
                <thead class="bg-gray-100/50 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-b border-[#c4b5a6]">
                    <tr>
                        <th class="p-5">Student Details</th>
                        <th class="p-5">Enrollment No.</th>
                        <th class="p-5">Branch & Sem</th>
                        <th class="p-5">Academic Info</th>
                        <th class="p-5">Email Address</th>
                        <th class="p-5">Payment</th>
                        <th class="p-5">Documents</th>
                        <th class="p-5">Status</th>
                        <th class="p-5 text-center">Approve</th>
                        <th class="p-5 text-center">Delete</th>
                    </tr>
                </thead>
                <tbody id="smTableBody">
                    <!-- Rows dynamically loaded -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Check admin auth
    (function() {
        const token = localStorage.getItem('tp_token');
        const role = localStorage.getItem('tp_role');
        if (!token || role !== 'Admin') {
            window.location.href = '/Auth/Login';
            return;
        }
    })();

    let studentsData = [];

    document.addEventListener('DOMContentLoaded', loadStudents);

    async function loadStudents() {
        const loading = document.getElementById('smLoading');
        const empty = document.getElementById('smEmpty');
        const tableContainer = document.getElementById('smTableContainer');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        tableContainer.classList.add('hidden');

        try {
            const result = await authFetch('/api/admin/students').then(r => r.json());

            if (result.success && result.data) {
                studentsData = result.data;
                renderStudents(studentsData);
            } else {
                empty.classList.remove('hidden');
            }
        } catch (err) {
            showToast('Failed to load students. Please refresh.', 'error');
        } finally {
            loading.classList.add('hidden');
        }
    }

    function renderStudents(students) {
        const tbody = document.getElementById('smTableBody');
        const empty = document.getElementById('smEmpty');
        const tableContainer = document.getElementById('smTableContainer');

        if (!students || students.length === 0) {
            empty.classList.remove('hidden');
            tableContainer.classList.add('hidden');
            return;
        }

        tableContainer.classList.remove('hidden');
        empty.classList.add('hidden');

        document.getElementById('smCount').textContent = students.length;
        const approved = students.filter(s => s.isApproved).length;
        document.getElementById('smApprovedCount').textContent = approved;
        document.getElementById('smPendingCount').textContent = students.length - approved;

        tbody.innerHTML = '';
        students.forEach(s => {
            const row = document.createElement('tr');
            row.id = 'studentRow' + s.id;
            row.className = 'border-b border-[#c4b5a6]/30 text-sm transition-colors hover:bg-white/40 ' + (s.isApproved ? 'bg-green-50/30' : 'bg-white/10');

            // Payment badge
            let payBadge = '';
            if (s.paymentStatus === 'Paid') {
                payBadge = `<span class="px-2 py-1 rounded-lg text-[10px] font-extrabold uppercase bg-green-100 text-green-700 border border-green-200">PAID</span>`;
            } else {
                payBadge = `<span class="px-2 py-1 rounded-lg text-[10px] font-extrabold uppercase bg-yellow-100 text-yellow-700 border border-yellow-200">PENDING</span>`;
            }

            // Document links
            let docLinks = '';
            if (s.consentFormPath) {
                docLinks += `<a href="/api/admin/students/${s.id}/document/consent" target="_blank" class="flex items-center gap-1.5 text-blue-600 font-bold no-underline hover:underline text-xs" title="Download Consent Form"><i class="fas fa-file-pdf text-red-500"></i>CONSENT</a>`;
            }
            if (s.paymentProofPath) {
                docLinks += `<a href="/api/admin/students/${s.id}/document/payment" target="_blank" class="flex items-center gap-1.5 text-blue-600 font-bold no-underline hover:underline text-xs mt-2" title="View Payment Proof"><i class="fas fa-image text-blue-500"></i>RECEIPT</a>`;
            }
            if (!s.consentFormPath && !s.paymentProofPath) {
                docLinks = '<span class="text-gray-400 text-xs font-bold">MISSING</span>';
            }

            row.innerHTML = `
                <td class="p-5">
                    <div class="font-bold text-gray-900">${escapeHtml(s.fullName)}</div>
                    <div class="text-[10px] text-gray-500 font-extrabold uppercase tracking-tight">${s.registeredAt ? new Date(s.registeredAt).toLocaleDateString() : 'N/A'}</div>
                </td>
                <td class="p-5 font-bold text-gray-700 text-xs">${escapeHtml(s.enrollmentNumber)}</td>
                <td class="p-5">
                    <div class="font-bold text-gray-700 text-xs">${escapeHtml(s.branch)}</div>
                    <div class="text-xs text-gray-500">Sem ${escapeHtml(s.semester)}</div>
                </td>
                <td class="p-5">
                    <div class="text-xs font-extrabold text-[#e7000b]">${s.cgpa} CGPA</div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase underline decoration-red-500 decoration-2">Marksheets</div>
                </td>
                <td class="p-5 text-xs font-bold text-gray-600 lowercase">${escapeHtml(s.email)}</td>
                <td class="p-5">${payBadge}</td>
                <td class="p-5">${docLinks}</td>
                <td class="p-5">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider ${s.isApproved ? 'bg-green-100 text-green-700 shadow-sm' : 'bg-yellow-100 text-yellow-700 shadow-sm'}">
                        ${s.isApproved ? 'APPROVED' : 'PENDING'}
                    </span>
                </td>
                <td class="p-5 text-center">
                    <div class="flex justify-center">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" ${s.isApproved ? 'checked' : ''} 
                                   class="sr-only peer"
                                   onchange="toggleApproval(${s.id}, this.checked)" />
                            <div class="w-9 h-5 bg-gray-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-green-600"></div>
                        </label>
                    </div>
                </td>
                <td class="p-5 text-center">
                    <button onclick="deleteStudent(${s.id}, '${escapeHtml(s.fullName)}')" class="text-gray-400 cursor-pointer bg-transparent border-none text-base hover:text-red-600 transition-colors">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    async function toggleApproval(studentId, isApproved) {
        const token = localStorage.getItem('tp_token');
        const endpoint = isApproved ? 'approve' : 'reject';

        try {
            const response = await fetch(`/api/admin/students/${studentId}/${endpoint}`, {
                method: 'PUT',
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (response.status === 401) {
                localStorage.clear();
                window.location.href = '/Auth/Login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                showToast(result.message, 'success');
                await loadStudents();
            } else {
                showToast(result.message || 'Operation failed.', 'error');
                await loadStudents();
            }
        } catch (err) {
            showToast('Network error. Please try again.', 'error');
            await loadStudents();
        }
    }

    async function deleteStudent(studentId, studentName) {
        if (!confirm(`Are you sure you want to delete ${studentName}? This action cannot be undone.`)) {
            return;
        }

        const token = localStorage.getItem('tp_token');

        try {
            const response = await fetch(`/api/admin/students/${studentId}`, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (response.status === 401) {
                localStorage.clear();
                window.location.href = '/Auth/Login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                showToast(result.message, 'success');
                await loadStudents();
            } else {
                showToast(result.message || 'Delete failed.', 'error');
            }
        } catch (err) {
            showToast('Network error. Please try again.', 'error');
        }
    }

    function showToast(message, type) {
        const toast = document.getElementById('smToast');
        toast.textContent = message;
        toast.className = 'fixed top-6 right-6 z-50 px-6 py-3 rounded-xl shadow-lg text-sm font-medium transition-all duration-300';

        if (type === 'success') {
            toast.classList.add('bg-green-500', 'text-white');
        } else {
            toast.classList.add('bg-red-500', 'text-white');
        }

        toast.classList.remove('hidden');

        setTimeout(() => {
            toast.classList.add('hidden');
        }, 3000);
    }

    function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }
</script>
}
