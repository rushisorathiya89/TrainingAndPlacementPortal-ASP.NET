@{ ViewData["Title"] = "Students Management"; }

<div class="w-full">
    <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-red-600">Students Management</h1>
        <p class="text-gray-600 text-sm md:text-base">Manage student registrations and approvals.</p>
    </div>

    <!-- Toast Messages -->
    <div id="smToast" class="hidden fixed top-6 right-6 z-50 px-6 py-3 rounded-xl shadow-lg text-sm font-medium transition-all duration-300"></div>

    <!-- Loading State -->
    <div id="smLoading" class="text-center py-12">
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-red-600 mx-auto"></div>
        <p class="text-gray-500 mt-4">Loading students...</p>
    </div>

    <!-- Empty State -->
    <div id="smEmpty" class="hidden text-center py-12 bg-white rounded-xl shadow">
        <i class="fas fa-users text-gray-300 text-5xl mb-4"></i>
        <p class="text-gray-500 text-lg">No student registrations yet.</p>
        <p class="text-gray-400 text-sm mt-1">Students will appear here after they register on the portal.</p>
    </div>

    <!-- Students Table -->
    <div id="smTableContainer" class="hidden bg-white rounded-xl shadow overflow-x-auto">
        <div class="p-4 border-b flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <p class="text-sm text-gray-500"><span id="smCount" class="font-bold text-gray-800">0</span> registered students</p>
            <div class="flex gap-2">
                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium"><i class="fas fa-check-circle mr-1"></i> Approved: <span id="smApprovedCount">0</span></span>
                <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium"><i class="fas fa-clock mr-1"></i> Pending: <span id="smPendingCount">0</span></span>
            </div>
        </div>
        <table class="w-full text-left min-w-[800px]">
            <thead class="bg-white text-sm border-b">
                <tr>
                    <th class="p-4">Student Name</th>
                    <th class="p-4">Enrollment No.</th>
                    <th class="p-4">Course / Branch</th>
                    <th class="p-4">Semester</th>
                    <th class="p-4">CGPA</th>
                    <th class="p-4">Email</th>
                    <th class="p-4">Status</th>
                    <th class="p-4">Approval</th>
                    <th class="p-4">Delete</th>
                </tr>
            </thead>
            <tbody id="smTableBody">
                <!-- Rows dynamically loaded -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // Check admin auth
    (function() {
        const token = localStorage.getItem('tp_token');
        const role = localStorage.getItem('tp_role');
        if (!token || role !== 'Admin') {
            window.location.href = '/Auth/Login';
            return;
        }
    })();

    let studentsData = [];

    document.addEventListener('DOMContentLoaded', loadStudents);

    async function loadStudents() {
        const loading = document.getElementById('smLoading');
        const empty = document.getElementById('smEmpty');
        const tableContainer = document.getElementById('smTableContainer');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        tableContainer.classList.add('hidden');

        try {
            const token = localStorage.getItem('tp_token');
            const response = await fetch('/api/admin/students', {
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (response.status === 401) {
                localStorage.clear();
                window.location.href = '/Auth/Login';
                return;
            }

            const result = await response.json();

            if (result.success && result.data) {
                studentsData = result.data;
                renderStudents(studentsData);
            } else {
                empty.classList.remove('hidden');
            }
        } catch (err) {
            showToast('Failed to load students. Please refresh.', 'error');
        } finally {
            loading.classList.add('hidden');
        }
    }

    function renderStudents(students) {
        const tbody = document.getElementById('smTableBody');
        const empty = document.getElementById('smEmpty');
        const tableContainer = document.getElementById('smTableContainer');

        if (!students || students.length === 0) {
            empty.classList.remove('hidden');
            tableContainer.classList.add('hidden');
            return;
        }

        tableContainer.classList.remove('hidden');
        empty.classList.add('hidden');

        // Update counts
        document.getElementById('smCount').textContent = students.length;
        const approved = students.filter(s => s.isApproved).length;
        document.getElementById('smApprovedCount').textContent = approved;
        document.getElementById('smPendingCount').textContent = students.length - approved;

        tbody.innerHTML = '';
        students.forEach(s => {
            const row = document.createElement('tr');
            row.id = 'studentRow' + s.id;
            row.className = 'border-t text-sm ' + (s.isApproved ? 'bg-green-50' : 'bg-[#d8cfc3]');
            row.innerHTML = `
                <td class="p-4 font-semibold">${escapeHtml(s.fullName)}</td>
                <td class="p-4">${escapeHtml(s.enrollmentNumber)}</td>
                <td class="p-4">${escapeHtml(s.branch)}</td>
                <td class="p-4">${escapeHtml(s.semester)}</td>
                <td class="p-4">${s.cgpa}</td>
                <td class="p-4">${escapeHtml(s.email)}</td>
                <td class="p-4">
                    <span class="px-2 py-1 rounded-full text-xs font-medium ${s.isApproved ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}">
                        ${s.isApproved ? 'Approved' : 'Pending'}
                    </span>
                </td>
                <td class="p-4 text-center">
                    <input type="checkbox" ${s.isApproved ? 'checked' : ''} 
                        class="accent-purple-600 w-4 h-4 cursor-pointer"
                        onchange="toggleApproval(${s.id}, this.checked)" />
                </td>
                <td class="p-4 text-center">
                    <button onclick="deleteStudent(${s.id}, '${escapeHtml(s.fullName)}')" class="text-red-600 cursor-pointer bg-transparent border-none text-base hover:text-red-800 transition">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    async function toggleApproval(studentId, isApproved) {
        const token = localStorage.getItem('tp_token');
        const endpoint = isApproved ? 'approve' : 'reject';

        try {
            const response = await fetch(`/api/admin/students/${studentId}/${endpoint}`, {
                method: 'PUT',
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (response.status === 401) {
                localStorage.clear();
                window.location.href = '/Auth/Login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                showToast(result.message, 'success');
                // Reload to update UI
                await loadStudents();
            } else {
                showToast(result.message || 'Operation failed.', 'error');
                await loadStudents(); // Reload to reset checkbox state
            }
        } catch (err) {
            showToast('Network error. Please try again.', 'error');
            await loadStudents();
        }
    }

    async function deleteStudent(studentId, studentName) {
        if (!confirm(`Are you sure you want to delete ${studentName}? This action cannot be undone.`)) {
            return;
        }

        const token = localStorage.getItem('tp_token');

        try {
            const response = await fetch(`/api/admin/students/${studentId}`, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (response.status === 401) {
                localStorage.clear();
                window.location.href = '/Auth/Login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                showToast(result.message, 'success');
                await loadStudents();
            } else {
                showToast(result.message || 'Delete failed.', 'error');
            }
        } catch (err) {
            showToast('Network error. Please try again.', 'error');
        }
    }

    function showToast(message, type) {
        const toast = document.getElementById('smToast');
        toast.textContent = message;
        toast.className = 'fixed top-6 right-6 z-50 px-6 py-3 rounded-xl shadow-lg text-sm font-medium transition-all duration-300';

        if (type === 'success') {
            toast.classList.add('bg-green-500', 'text-white');
        } else {
            toast.classList.add('bg-red-500', 'text-white');
        }

        toast.classList.remove('hidden');

        setTimeout(() => {
            toast.classList.add('hidden');
        }, 3000);
    }

    function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }
</script>
}
