@{ ViewData["Title"] = "Admin Profile"; }

<div class="w-full">
    <!-- Header -->
    <h1 class="text-2xl md:text-3xl font-bold text-red-600">Admin Profile Edit</h1>
    <p class="text-gray-600 mb-8">Update your information.</p>

    <!-- Top Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- ProfileCard -->
        <div class="bg-[#d8cfc3] rounded-xl p-6 md:p-8 shadow-sm relative overflow-hidden">
            <div class="flex flex-col items-center mb-6">
                <!-- Initials Avatar -->
                <div id="adminInitialsDisplay" class="w-24 h-24 bg-red-600 text-white rounded-full flex items-center justify-center text-3xl font-bold shadow-lg border-4 border-white transition-transform hover:scale-105">
                    ...
                </div>
                
                <div class="w-full flex flex-col items-center mt-4">
                    <!-- Name -->
                    <h2 id="adminNameDisplay" class="admin-profile-display text-xl font-bold text-gray-800 m-0">Loading...</h2>
                    <div class="admin-profile-input hidden w-3/4">
                        <input id="adminNameInput" class="w-full text-center bg-white rounded-lg border border-gray-300 p-2 font-bold focus:ring-2 focus:ring-red-300 outline-none" oninput="document.getElementById('adminInfoNameInput').value = this.value" />
                        <p id="adminNameError" class="text-red-500 text-xs mt-1 text-center hidden"></p>
                    </div>
                    
                    <!-- Role badge-style -->
                    <p id="adminRoleDisplay" class="admin-profile-display mt-2 px-3 py-1 bg-white rounded-full text-gray-600 text-xs font-semibold shadow-sm">...</p>
                    <div class="admin-profile-input hidden w-1/2 mt-2">
                        <input id="adminRoleInput" class="w-full text-center bg-white rounded-lg border border-gray-300 p-2 text-xs font-semibold focus:ring-2 focus:ring-red-300 outline-none" oninput="document.getElementById('adminInfoRoleInput').value = this.value" />
                    </div>
                </div>
            </div>
            
            <div class="space-y-4">
                <div class="flex justify-between items-center bg-white/50 p-3 rounded-lg">
                    <span class="text-gray-600 font-medium">Employee Id.</span>
                    <span id="adminEmpIdDisplay" class="admin-profile-display font-bold text-gray-800">...</span>
                    <input id="adminEmpIdInput" class="admin-profile-input hidden text-right bg-white border border-gray-300 rounded px-2 py-1 outline-none focus:ring-2 focus:ring-red-300" />
                </div>
                <div class="flex justify-between items-center bg-white/50 p-3 rounded-lg">
                    <span class="text-gray-600 font-medium">Department</span>
                    <span id="adminDeptDisplay" class="admin-profile-display font-bold text-gray-800 text-right">...</span>
                    <input id="adminDeptInput" class="admin-profile-input hidden text-right bg-white border border-gray-300 rounded px-2 py-1 outline-none focus:ring-2 focus:ring-red-300" />
                </div>
                <div class="flex justify-between items-center bg-white/50 p-3 rounded-lg">
                    <span class="text-gray-600 font-medium">Office Location</span>
                    <span id="adminLocDisplay" class="admin-profile-display font-bold text-gray-800 text-right">...</span>
                    <input id="adminLocInput" class="admin-profile-input hidden text-right bg-white border border-gray-300 rounded px-2 py-1 outline-none focus:ring-2 focus:ring-red-300" />
                </div>
            </div>
            
            <button id="editAdminProfileBtn" onclick="toggleAdminProfileEdit()" data-editing="false" class="mt-8 w-full bg-red-600 hover:bg-red-700 text-white py-3 rounded-xl flex items-center justify-center gap-2 cursor-pointer border-none font-bold shadow-md transition-all active:scale-95">
                <i class="fas fa-edit"></i> <span id="btnText">EDIT PROFILE</span>
            </button>
        </div>

        <!-- ProfileInfoForm -->
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-sm border border-gray-100">
            <h2 class="text-lg font-bold text-gray-800 mb-6 flex items-center gap-2">
                <i class="fas fa-info-circle text-red-600"></i> Profile Information
            </h2>
            <div class="space-y-5">
                <div class="group">
                    <label class="text-xs font-bold text-gray-500 uppercase tracking-wider">Full Name</label>
                    <input id="adminInfoNameInput" readonly class="w-full mt-1 rounded-lg p-3 bg-gray-50 border border-gray-100 outline-none text-gray-800 font-semibold" />
                </div>
                <div>
                    <label class="text-xs font-bold text-gray-500 uppercase tracking-wider">Mobile Number</label>
                    <input id="adminMobileInput" readonly class="admin-info-field w-full mt-1 rounded-lg p-3 bg-gray-50 border border-gray-100 outline-none text-gray-800 font-semibold" />
                </div>
                <div>
                    <label class="text-xs font-bold text-gray-500 uppercase tracking-wider">Email Address</label>
                    <input id="adminEmailInput" readonly class="w-full mt-1 rounded-lg p-3 bg-gray-50 border border-gray-100 outline-none text-gray-500" />
                </div>
                <div>
                    <label class="text-xs font-bold text-gray-500 uppercase tracking-wider">Role</label>
                    <input id="adminInfoRoleInput" readonly class="w-full mt-1 rounded-lg p-3 bg-gray-50 border border-gray-100 outline-none text-gray-800 font-semibold" />
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6 items-start">
        <!-- AddPortalUser -->
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-sm border border-gray-100">
            <h2 class="text-lg font-bold text-gray-800 mb-6 flex items-center gap-2">
                <i class="fas fa-user-plus text-red-600"></i> Add New Portal Access
            </h2>
            <div class="space-y-4">
                <div>
                    <label class="text-xs font-bold text-gray-500 uppercase">Email Address</label>
                    <input id="newUserEmail" placeholder="e.g. name@rku.ac.in" class="w-full mt-1 p-3 rounded-lg bg-gray-50 border border-gray-200 outline-none focus:ring-2 focus:ring-red-300 transition" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">Password</label>
                        <input id="newUserPassword" type="password" placeholder="••••••••" class="w-full mt-1 p-3 rounded-lg bg-gray-50 border border-gray-200 outline-none focus:ring-2 focus:ring-red-300 transition" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">Confirm Password</label>
                        <input id="newUserConfirm" type="password" placeholder="••••••••" class="w-full mt-1 p-3 rounded-lg bg-gray-50 border border-gray-200 outline-none focus:ring-2 focus:ring-red-300 transition" />
                    </div>
                </div>
                <div class="pt-2 flex gap-3">
                    <button class="flex-1 bg-red-600 text-white py-3 rounded-lg hover:bg-red-700 border-none cursor-pointer font-bold shadow transition active:scale-95" onclick="addNewPortalUser()">
                        Create User
                    </button>
                    <button class="px-6 border border-gray-300 bg-white py-3 rounded-lg hover:bg-gray-50 cursor-pointer text-gray-600 font-semibold transition" onclick="document.getElementById('newUserEmail').value=''; document.getElementById('newUserPassword').value=''; document.getElementById('newUserConfirm').value=''">
                        Cancel
                    </button>
                </div>
            </div>
        </div>

        <!-- PasswordActions -->
        <div class="flex flex-col gap-4">
            <a href="/Admin/ChangePassword" class="group bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between no-underline transition hover:bg-red-50">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center group-hover:bg-red-600 group-hover:text-white transition">
                        <i class="fas fa-key"></i>
                    </div>
                    <span class="font-bold text-gray-700 group-hover:text-red-700">Change Account Password</span>
                </div>
                <i class="fas fa-chevron-right text-gray-300 group-hover:text-red-400"></i>
            </a>
            <a href="/Admin/ForgotPassword" class="group bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between no-underline transition hover:bg-red-50">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gray-100 text-gray-600 rounded-full flex items-center justify-center group-hover:bg-red-600 group-hover:text-white transition">
                        <i class="fas fa-unlock-alt"></i>
                    </div>
                    <span class="font-bold text-gray-700 group-hover:text-red-700">Forgot / Reset Credentials</span>
                </div>
                <i class="fas fa-chevron-right text-gray-300 group-hover:text-red-400"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Admin')) return;
    loadAdminProfile();
});

async function loadAdminProfile() {
    try {
        const res = await authFetch('/api/auth/me');
        const result = await res.json();
        
        if (result.success && result.data) {
            const data = result.data;
            
            // Text displays
            document.getElementById('adminNameDisplay').innerText = data.fullName;
            document.getElementById('adminRoleDisplay').innerText = data.role;
            document.getElementById('adminEmpIdDisplay').innerText = data.empId;
            document.getElementById('adminDeptDisplay').innerText = data.department;
            document.getElementById('adminLocDisplay').innerText = data.location;
            
            // Inputs
            document.getElementById('adminNameInput').value = data.fullName;
            document.getElementById('adminRoleInput').value = data.role;
            document.getElementById('adminEmpIdInput').value = data.empId;
            document.getElementById('adminDeptInput').value = data.department;
            document.getElementById('adminLocInput').value = data.location;
            
            // Profile Form
            document.getElementById('adminInfoNameInput').value = data.fullName;
            document.getElementById('adminMobileInput').value = data.mobileNumber;
            document.getElementById('adminEmailInput').value = data.email;
            document.getElementById('adminInfoRoleInput').value = data.role;
            
            // Avatar
            const initials = (data.fullName || "Admin").split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
            document.getElementById('adminInitialsDisplay').innerText = initials;
        }
    } catch (err) {
        console.error('Failed to load profile:', err);
    }
}

async function saveAdminProfile() {
    const payload = {
        fullName: document.getElementById('adminNameInput').value,
        mobileNumber: document.getElementById('adminMobileInput').value, // This is readonly currently, but we include it
        role: document.getElementById('adminRoleInput').value,
        empId: document.getElementById('adminEmpIdInput').value,
        department: document.getElementById('adminDeptInput').value,
        location: document.getElementById('adminLocInput').value
    };

    try {
        const res = await authFetch('/api/auth/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const result = await res.json();
        
        if (result.success) {
            alert('Profile updated successfully!');
            setProfileEditingMode(false);
            loadAdminProfile(); 
        } else {
            alert(result.message || 'Failed to update profile.');
        }
    } catch (err) {
        alert('Network error. Please try again.');
        console.error(err);
    }
}

function toggleAdminProfileEdit() {
    const btn = document.getElementById('editAdminProfileBtn');
    const isEditing = btn.dataset.editing === 'true';
    
    if (isEditing) {
        saveAdminProfile();
    } else {
        setProfileEditingMode(true);
    }
}

function setProfileEditingMode(enableEditing) {
    const btn = document.getElementById('editAdminProfileBtn');
    const displays = document.querySelectorAll('.admin-profile-display');
    const inputs = document.querySelectorAll('.admin-profile-input');
    const infoFields = document.querySelectorAll('.admin-info-field');
    
    if (enableEditing) {
        btn.dataset.editing = 'true';
        btn.innerHTML = '<i class="fas fa-save"></i> SAVE PROFILE';
        btn.classList.replace('bg-red-600', 'bg-green-600');
        btn.classList.replace('hover:bg-red-700', 'hover:bg-green-700');
        
        displays.forEach(d => d.classList.add('hidden'));
        inputs.forEach(i => i.classList.remove('hidden'));
        
        // Make mobile number editable during this mode
        const mobile = document.getElementById('adminMobileInput');
        mobile.readOnly = false;
        mobile.classList.replace('bg-gray-50', 'bg-white');
        mobile.classList.add('ring-2', 'ring-blue-100');

    } else {
        btn.dataset.editing = 'false';
        btn.innerHTML = '<i class="fas fa-edit"></i> EDIT PROFILE';
        btn.classList.replace('bg-green-600', 'bg-red-600');
        btn.classList.replace('hover:bg-green-700', 'hover:bg-red-700');
        
        displays.forEach(d => d.classList.remove('hidden'));
        inputs.forEach(i => i.classList.add('hidden'));
        
        const mobile = document.getElementById('adminMobileInput');
        mobile.readOnly = true;
        mobile.classList.replace('bg-white', 'bg-gray-50');
        mobile.classList.remove('ring-2', 'ring-blue-100');
    }
}
</script>
}
