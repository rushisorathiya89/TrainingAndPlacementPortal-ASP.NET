@{ ViewData["Title"] = "Admin Dashboard"; }

<div class="w-full">
    <h1 class="text-2xl md:text-3xl font-bold text-red-600">Dashboard</h1>
    <p class="text-gray-600 mb-8">Overview of placement activities and statistics.</p>

    <!-- Statistics -->
    <div id="statsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <!-- Stats will load here -->
        <div class="col-span-full py-10 text-center text-gray-400">Loading statistics...</div>
    </div>

    <!-- Quick Actions -->
    <h2 class="text-xl md:text-2xl font-bold text-red-600 mb-6 m-0">Quick Actions</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        @{
            var actions = new[] {
                new { Title = "Companies", Desc = "Explore Company details and JD", Btn = "View Companies →", Href = "/AdminCompanyManagement", Icon = "fa-briefcase", Color = "text-orange-500" },
                new { Title = "Students", Desc = "Explore Student Details", Btn = "View Student Details →", Href = "/AdminStudentsManagement", Icon = "fa-search", Color = "text-cyan-500" },
                new { Title = "Interview Schedule", Desc = "Manage Interviews", Btn = "View Schedules →", Href = "/AdminInterviewSchedule", Icon = "fa-file-alt", Color = "text-blue-600" },
                new { Title = "History", Desc = "Explore Placement History", Btn = "View Placement History →", Href = "/AdminPlacementHistory", Icon = "fa-clock", Color = "text-red-500" },
                new { Title = "Profile", Desc = "Update your information", Btn = "Edit Profile →", Href = "/AdminProfile", Icon = "fa-users", Color = "text-purple-500" }
            };
        }
        @foreach (var a in actions)
        {
            <div class="bg-[#d1c2b5] p-8 rounded-xl shadow text-center border border-[#c4b5a6] transition-transform hover:scale-[1.02]">
                <div class="flex justify-center mb-4 text-3xl">
                    <i class="fas @a.Icon @a.Color"></i>
                </div>
                <h3 class="text-lg font-bold mb-1 m-0">@a.Title</h3>
                <p class="text-gray-700 text-sm m-0">@a.Desc</p>
                <a href="@a.Href" class="mt-4 font-bold @a.Color inline-block cursor-pointer border-none bg-transparent no-underline uppercase tracking-tight text-xs">
                    @a.Btn
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Admin')) return;
            await loadDashboardStats();
        });

        async function loadDashboardStats() {
            try {
                const res = await authFetch('/api/admin/stats');
                if (!res || !res.ok) throw new Error('Failed to fetch stats');
                const result = await res.json();
                
                if (result.success) {
                    renderStats(result.data);
                }
            } catch (err) {
                console.error(err);
                document.getElementById('statsGrid').innerHTML = '<p class="text-red-500 col-span-full">Failed to load statistics.</p>';
            }
        }

        function renderStats(data) {
            const stats = [
                { title: "Total Students", value: data.totalStudents, icon: "fa-users", color: "text-blue-600", bg: "bg-blue-100" },
                { title: "Pending Approvals", value: data.pendingApprovals, icon: "fa-clock", color: "text-red-600", bg: "bg-red-100" },
                { title: "Active Job Drives", value: data.activeJobDrives, icon: "fa-briefcase", color: "text-blue-600", bg: "bg-blue-100" },
                { title: "Total Applications", value: data.totalApplications, icon: "fa-file-alt", color: "text-blue-600", bg: "bg-blue-100" },
                { title: "Shortlisted Students", value: data.shortlisted, icon: "fa-check-circle", color: "text-blue-600", bg: "bg-blue-100" },
                { title: "Selected Students", value: data.placed, icon: "fa-trophy", color: "text-blue-600", bg: "bg-blue-100" }
            ];

            let html = '';
            stats.forEach(s => {
                html += `
                <div class="flex justify-between items-center bg-[#d1c2b5] p-6 rounded-xl shadow-sm border border-[#c4b5a6]">
                    <div>
                        <p class="text-gray-700 text-sm font-bold uppercase tracking-wider m-0 mb-1">${s.title}</p>
                        <h2 class="text-3xl font-extrabold text-[#e7000b] m-0">${s.value.toLocaleString()}</h2>
                    </div>
                    <div class="p-3 rounded-xl ${s.bg} shadow-sm">
                        <i class="fas ${s.icon} ${s.color} text-xl w-[20px] h-[20px] flex items-center justify-center"></i>
                    </div>
                </div>`;
            });

            document.getElementById('statsGrid').innerHTML = html;
        }
    </script>
}
