@{ ViewData["Title"] = "Placement History"; }

<div class="w-full">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-red-600">Placement History</h1>
        <p class="text-gray-600 text-sm md:text-base">Manage And maintain A Placement Records</p>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl shadow overflow-x-auto">
        <table class="w-full text-left min-w-[900px]">
            <thead class="bg-gray-200">
                <tr>
                    <th class="p-4">Company Name</th>
                    <th class="p-4">Job Role</th>
                    <th class="p-4">Package</th>
                    <th class="p-4 text-center">Selected Students</th>
                    <th class="p-4">Offer Date</th>
                    <th class="p-4">Joining Date</th>
                    <th class="p-4">Status</th>
                </tr>
            </thead>
            <tbody id="historyTableBody">
                <tr id="historyLoading">
                    <td colspan="7" class="p-8 text-center text-gray-500">
                        <i class="fas fa-spinner fa-spin text-2xl text-red-500 mb-2 block"></i>
                        Loading placement history...
                    </td>
                </tr>
                <tr id="historyEmpty" class="hidden">
                    <td colspan="7" class="p-8 text-center text-gray-500">
                        <i class="fas fa-folder-open text-4xl text-gray-300 mb-2 block"></i>
                        No placement records found.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Admin')) return;
    loadPlacementHistory();
});

async function loadPlacementHistory() {
    const loading = document.getElementById('historyLoading');
    const empty = document.getElementById('historyEmpty');
    const tbody = document.getElementById('historyTableBody');

    try {
        const res = await authFetch('/api/admin/placement-history');
        const result = await res.json();
        
        loading.classList.add('hidden');
        
        if (!result.success || !result.data || result.data.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        result.data.forEach(p => {
            const tr = document.createElement('tr');
            tr.className = 'bg-white border-t hover:bg-gray-50';

            // Determine status label and class
            let statusClass = "bg-blue-100 text-blue-700";
            let statusLabel = p.statusLabel;

            if (p.statusLabel === 'Completed') statusClass = "bg-green-100 text-green-700";
            else if (p.statusLabel === 'Rejected') statusClass = "bg-red-100 text-red-600";
            else if (statusLabel === 'Approved') statusClass = "bg-blue-100 text-blue-700";

            // Format dates
            let offerDateDisplay = "-";
            if (p.offerDate) {
                const od = new Date(p.offerDate);
                // check if it's a valid future/past date
                if (od.getFullYear() > 2000) offerDateDisplay = od.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
            }

            let joiningDateDisplay = "-";
            if (p.joiningDate) {
                const jd = new Date(p.joiningDate);
                if (jd.getFullYear() > 2000) joiningDateDisplay = jd.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
            }

            tr.innerHTML = `
                <td class="p-4 flex items-center gap-3 font-semibold">
                    <div class="bg-blue-200 text-blue-700 w-10 h-10 flex items-center justify-center rounded-lg">
                        <i class="fas fa-building"></i>
                    </div>
                    ${escapeHtml(p.companyName || 'N/A')}
                </td>
                <td class="p-4">${escapeHtml(p.jobRole || 'N/A')}</td>
                <td class="p-4 font-semibold">${escapeHtml(p.package || 'N/A')}</td>
                <td class="p-4 text-center font-semibold text-gray-700">${p.selectedStudents}</td>
                <td class="p-4">${offerDateDisplay}</td>
                <td class="p-4">${joiningDateDisplay}</td>
                <td class="p-4">
                    <span class="px-3 py-1 rounded-full text-sm ${statusClass}">
                        ${escapeHtml(statusLabel)}
                    </span>
                </td>
            `;
            tbody.appendChild(tr);
        });

    } catch (err) {
        loading.classList.add('hidden');
        empty.classList.remove('hidden');
        empty.querySelector('td').innerText = 'Failed to load placement history.';
        console.error('Error fetching history:', err);
    }
}

function escapeHtml(unsafe) {
    if (!unsafe) return '';
    return unsafe
         .toString()
         .replace(/&/g, "&amp;")
         .replace(/</g, "&lt;")
         .replace(/>/g, "&gt;")
         .replace(/"/g, "&quot;")
         .replace(/'/g, "&#039;");
}
</script>
}
