@{ ViewData["Title"] = "Placement History"; }

<div class="w-full">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-red-600">Placement History</h1>
        <p class="text-gray-600 text-sm md:text-base">Manage And maintain A Placement Records</p>
    </div>

    <!-- Dynamic Table Container -->
    <div id="historyTableContainer" class="bg-white rounded-2xl shadow-sm border border-[#c4b5a6] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left min-w-[1000px] border-collapse">
                <thead class="bg-gray-100/50 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-b border-[#c4b5a6]">
                    <tr>
                        <th class="p-5">Company Details</th>
                        <th class="p-5">Job Role</th>
                        <th class="p-5">Annual CTC</th>
                        <th class="p-5 text-center">Placed Studs</th>
                        <th class="p-5 text-center">Drive Date</th>
                        <th class="p-5 text-center">Joining Date</th>
                        <th class="p-5 text-center">Selection Status</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody">
                    <tr id="historyPlaceholder">
                        <td colspan="7" class="p-12 text-center text-gray-400 font-bold uppercase tracking-widest">
                            <i class="fas fa-spinner fa-spin mr-2"></i>Loading Placement Records...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Admin')) return;
            await loadPlacementHistory();
        });

        async function loadPlacementHistory() {
            try {
                const res = await authFetch('/api/admin/placement-history');
                if (!res || !res.ok) throw new Error('Failed to fetch history');
                const result = await res.json();
                
                if (result.success) {
                    renderHistory(result.data);
                }
            } catch (err) {
                console.error(err);
                document.getElementById('historyTableBody').innerHTML = '<tr><td colspan="7" class="p-12 text-center text-red-500 font-bold">Failed to load placement history.</td></tr>';
            }
        }

        function renderHistory(data) {
            const tbody = document.getElementById('historyTableBody');
            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-12 text-center text-gray-500 font-bold uppercase tracking-widest">No placement records found yet.</td></tr>';
                return;
            }

            let html = '';
            data.forEach(p => {
                const driveDate = p.campusDriveDate ? new Date(p.campusDriveDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
                const joiningDate = p.dateOfJoining ? new Date(p.dateOfJoining).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
                const statusColor = p.status === 'Completed' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700';

                html += `
                <tr class="border-b border-[#c4b5a6]/30 text-sm transition-colors hover:bg-white/40">
                    <td class="p-5 font-bold text-gray-900 flex items-center gap-3">
                        <div class="w-10 h-10 bg-[#2563eb] rounded-xl flex items-center justify-center text-white shadow-sm font-bold text-lg">
                           ${p.companyName.charAt(0).toUpperCase()}
                        </div>
                        ${p.companyName}
                    </td>
                    <td class="p-5 text-gray-600 font-semibold">${p.jobRole}</td>
                    <td class="p-5 font-extrabold text-[#e7000b] tracking-tight">${p.package}</td>
                    <td class="p-5 text-center">
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-50 text-blue-700 font-extrabold text-xs shadow-sm border border-blue-200">
                            ${p.selectedCount}
                        </span>
                    </td>
                    <td class="p-5 text-center text-gray-600 font-bold text-xs capitalize">${driveDate}</td>
                    <td class="p-5 text-center text-gray-600 font-bold text-xs capitalize">${joiningDate}</td>
                    <td class="p-5 text-center">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider ${statusColor} shadow-sm border border-current/20">
                            ${p.status}
                        </span>
                    </td>
                </tr>`;
            });

            tbody.innerHTML = html;
        }
    </script>
}
</div>
