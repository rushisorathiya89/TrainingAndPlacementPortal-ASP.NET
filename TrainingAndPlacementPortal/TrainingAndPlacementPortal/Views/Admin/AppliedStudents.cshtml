@{ ViewData["Title"] = "Applied Students"; }

<div class="w-full">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 md:gap-0 relative z-10">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-red-600">Applied Students</h1>
            <p class="text-gray-600 text-sm md:text-base">List of students registered for this Job Drive.</p>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <button type="button" onclick="history.back()" class="border px-5 py-2 rounded-lg w-full md:w-auto bg-white cursor-pointer hover:bg-gray-50 text-gray-800">
                ← Back
            </button>
        </div>
    </div>

    <!-- Loading State -->
    <div id="studentsLoading" class="text-center py-12">
        <i class="fas fa-spinner fa-spin text-3xl text-red-500"></i>
        <p class="text-gray-500 mt-3">Loading students data...</p>
    </div>

    <!-- Empty State -->
    <div id="studentsEmpty" class="hidden text-center py-12">
        <i class="fas fa-users-slash text-5xl text-gray-300 mb-4"></i>
        <p class="text-gray-500">No students have applied for this job yet.</p>
    </div>

    <!-- Table -->
    <div id="studentsTableContainer" class="bg-white rounded-xl shadow overflow-x-auto hidden">
        <table class="w-full text-left min-w-[900px]">
            <thead class="bg-gray-200">
                <tr>
                    <th class="p-4">Student Name</th>
                    <th class="p-4">Enrollment Number</th>
                    <th class="p-4">Branch & Semester</th>
                    <th class="p-4">CGPA</th>
                    <th class="p-4">Application Status</th>
                    <th class="p-4">Applied On</th>
                </tr>
            </thead>
            <tbody id="studentsTableBody">
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Admin')) return;
    
    const urlParams = new URLSearchParams(window.location.search);
    const jobId = urlParams.get('jobId');
    if (jobId) {
        loadAppliedStudents(jobId);
    } else {
        document.getElementById('studentsLoading').classList.add('hidden');
        document.getElementById('studentsEmpty').classList.remove('hidden');
    }
});

async function loadAppliedStudents(jobId) {
    const loading = document.getElementById('studentsLoading');
    const empty = document.getElementById('studentsEmpty');
    const container = document.getElementById('studentsTableContainer');
    const tbody = document.getElementById('studentsTableBody');

    try {
        const res = await authFetch(`/api/applications/job/${jobId}/students`);
        const result = await res.json();

        loading.classList.add('hidden');

        if (!result.success || !result.data || result.data.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        container.classList.remove('hidden');
        tbody.innerHTML = '';

        result.data.forEach(s => {
            const tr = document.createElement('tr');
            tr.className = 'border-t hover:bg-gray-50 transition';
            
            const appliedDate = new Date(s.appliedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
            
            let badgeColor = 'bg-blue-100 text-blue-700';
            if (s.applicationStatus === 'Selected') badgeColor = 'bg-green-100 text-green-700';
            if (s.applicationStatus === 'Rejected') badgeColor = 'bg-red-100 text-red-700';
            if (s.applicationStatus === 'Shortlisted') badgeColor = 'bg-yellow-100 text-yellow-700';

            tr.innerHTML = `
                <td class="p-4 font-semibold text-gray-800">
                    <div class="flex flex-col">
                        <span>${escapeHtml(s.fullName || 'N/A')}</span>
                        <span class="text-xs text-gray-500 font-normal">${escapeHtml(s.email || '')}</span>
                        <span class="text-xs text-gray-500 font-normal">${escapeHtml(s.mobileNumber || '')}</span>
                    </div>
                </td>
                <td class="p-4 text-gray-700">${escapeHtml(s.enrollmentNumber || 'N/A')}</td>
                <td class="p-4 text-gray-700">${escapeHtml(s.branch || 'N/A')} (Sem ${s.semester || 'N/A'})</td>
                <td class="p-4 font-bold text-gray-800">${s.cgpa || 'N/A'}</td>
                <td class="p-4">
                    <select onchange="updateApplicationStatus(${s.id}, this.value)" class="p-2 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300 cursor-pointer text-sm font-semibold ${badgeColor}">
                        <option value="Applied" ${s.applicationStatus === 'Applied' ? 'selected' : ''}>Applied</option>
                        <option value="Shortlisted" ${s.applicationStatus === 'Shortlisted' ? 'selected' : ''}>Shortlisted</option>
                        <option value="Selected" ${s.applicationStatus === 'Selected' ? 'selected' : ''}>Selected</option>
                        <option value="Rejected" ${s.applicationStatus === 'Rejected' ? 'selected' : ''}>Rejected</option>
                    </select>
                </td>
                <td class="p-4 text-gray-500 text-sm">${appliedDate}</td>
            `;
            tbody.appendChild(tr);
        });

    } catch (err) {
        loading.classList.add('hidden');
        empty.classList.remove('hidden');
        empty.querySelector('p').innerText = 'Failed to load students. Please try again.';
        console.error('Error:', err);
    }
}

async function updateApplicationStatus(appId, newStatus) {
    try {
        const res = await authFetch(`/api/applications/${appId}/status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newStatus)
        });
        const result = await res.json();
        if (result.success) {
            // Optional: Show a subtle toast
            console.log('Status updated successfully');
        } else {
            alert(result.message || 'Failed to update status.');
        }
    } catch (err) {
        console.error('Error updating status:', err);
        alert('Failed to update status due to network error.');
    }
}

function escapeHtml(unsafe) {
    if (!unsafe) return '';
    return unsafe
         .toString()
         .replace(/&/g, "&amp;")
         .replace(/</g, "&lt;")
         .replace(/>/g, "&gt;")
         .replace(/"/g, "&quot;")
         .replace(/'/g, "&#039;");
}
</script>
}
