@{ ViewData["Title"] = "Company Management"; }

<div class="w-full">
    <h1 class="text-2xl md:text-3xl font-bold text-red-600">Company Management</h1>
    <p class="text-gray-600 mb-6 md:mb-8 text-sm md:text-base">Manage and maintain company information and records.</p>

    <!-- Search and Filter -->
    <div class="mb-6 flex flex-col md:flex-row gap-4 items-stretch md:items-center">
        <div class="relative flex-grow w-full">
            <input type="text" id="searchInput" placeholder="Search by company, role, location, or salary" oninput="filterCards()" class="w-full p-3 pl-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300" />
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>
        <div class="relative w-full md:w-48 flex-shrink-0">
            <select id="searchCategory" onchange="filterCards()" class="w-full appearance-none p-3 pr-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300 cursor-pointer text-gray-700 shadow-sm">
                <option value="All">All Categories</option>
                <option value="Company">Company Name</option>
                <option value="Role">Job Role</option>
                <option value="Location">Location</option>
                <option value="Salary">Salary</option>
            </select>
            <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
        </div>
        <div class="relative w-full md:w-72 flex-shrink-0">
            <select id="filterStatus" onchange="filterCards()" class="w-full appearance-none p-3 pr-10 rounded-lg border bg-white outline-none focus:ring-2 focus:ring-red-300 cursor-pointer text-gray-700 shadow-sm">
                <option value="All">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
                <option value="OnHold">On Hold</option>
            </select>
            <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
        </div>
    </div>

    <!-- Loading State -->
    <div id="companyLoading" class="text-center py-12">
        <i class="fas fa-spinner fa-spin text-3xl text-red-500"></i>
        <p class="text-gray-500 mt-3">Loading company data...</p>
    </div>

    <!-- Empty State -->
    <div id="companyEmpty" class="hidden text-center py-12">
        <i class="fas fa-building text-5xl text-gray-300 mb-4"></i>
        <p class="text-gray-500">No JD submissions found.</p>
    </div>

    <!-- Company Cards Container -->
    <div id="companyCardsContainer" class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6 hidden">
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Admin')) return;
    loadCompanyCards();
});

async function loadCompanyCards() {
    const container = document.getElementById('companyCardsContainer');
    const loading = document.getElementById('companyLoading');
    const empty = document.getElementById('companyEmpty');

    try {
        const res = await authFetch('/api/company/job-postings');
        const result = await res.json();

        loading.classList.add('hidden');

        if (!result.success || !result.data || result.data.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        container.classList.remove('hidden');
        container.innerHTML = '';

        result.data.forEach(jp => {
            const card = createCompanyCard(jp);
            container.appendChild(card);
        });

    } catch (err) {
        loading.classList.add('hidden');
        empty.classList.remove('hidden');
        console.error('Failed to load companies:', err);
    }
}

function createCompanyCard(jp) {
    const card = document.createElement('div');
    card.id = 'jp-' + jp.id;
    card.className = 'filterable-card bg-[#d8cfc3] p-6 rounded-xl shadow';
    card.dataset.name = jp.companyName;
    card.dataset.role = jp.jobPosition;
    card.dataset.location = jp.jobLocation || '';
    card.dataset.salary = jp.annualCTC;
    card.dataset.status = jp.status;

    const initial = jp.companyName ? jp.companyName.charAt(0).toUpperCase() : '?';
    const statusBadge = getStatusBadge(jp.status);

    card.innerHTML = `
        <!-- Header -->
        <div class="flex items-center gap-4 mb-3">
            <div class="bg-blue-600 text-white w-12 h-12 flex items-center justify-center rounded-lg text-xl font-bold">
                ${initial}
            </div>
            <div class="flex-1">
                <h3 class="font-bold text-lg m-0">${jp.companyName}</h3>
                <p class="text-gray-600 text-sm m-0">${jp.jobPosition}</p>
            </div>
            ${statusBadge}
        </div>

        <!-- Salary -->
        <p class="text-red-600 font-bold text-lg mb-2 m-0">${jp.annualCTC}</p>

        <!-- Location -->
        <p class="flex items-center gap-2 text-gray-600 text-sm mb-2 m-0">
            <i class="fas fa-map-marker-alt"></i>${jp.jobLocation || 'N/A'}
        </p>

        <!-- Selection Process -->
        <p class="text-gray-600 text-sm mb-4 m-0">${jp.selectionProcess || ''}</p>

        <!-- Action Buttons -->
        <div id="actions-${jp.id}" class="mb-3">
            ${getActionButtons(jp.id, jp.status)}
        </div>

        <!-- View/Edit Buttons -->
        <div class="grid grid-cols-2 gap-3">
            <a href="/Admin/JdDetail?id=${jp.id}" class="border flex items-center justify-center border-black py-2 rounded hover:bg-gray-50 transition text-black font-semibold no-underline text-center text-sm md:text-base cursor-pointer">
                VIEW DETAILS
            </a>
            <a href="/Admin/JdDetail?id=${jp.id}" class="bg-blue-600 text-white flex items-center justify-center py-2 rounded border-none hover:bg-blue-700 transition font-semibold text-center text-sm md:text-base no-underline cursor-pointer">
                EDIT DETAILS
            </a>
        </div>
    `;

    return card;
}

function getStatusBadge(status) {
    const colors = {
        'Pending': 'bg-yellow-100 text-yellow-800',
        'Approved': 'bg-green-100 text-green-800',
        'Rejected': 'bg-red-100 text-red-800',
        'OnHold': 'bg-gray-100 text-gray-800'
    };
    const labels = {
        'Pending': '⏳ Pending',
        'Approved': '✓ Approved',
        'Rejected': '✕ Rejected',
        'OnHold': '⏸ On Hold'
    };
    const color = colors[status] || colors['Pending'];
    const label = labels[status] || labels['Pending'];
    return `<span class="px-3 py-1 rounded-full text-xs font-bold ${color}">${label}</span>`;
}

function getActionButtons(id, status) {
    if (status === 'Approved') {
        return `
            <div class="grid grid-cols-2 gap-2">
                <button disabled class="bg-green-600 text-white py-2 rounded cursor-not-allowed border-none font-semibold">✓ APPROVED</button>
                <button onclick="updateJpStatus(${id}, 'Pending')" class="bg-gray-500 text-white py-2 rounded hover:bg-gray-600 transition cursor-pointer border-none font-semibold">Undo</button>
            </div>`;
    }
    if (status === 'Rejected') {
        return `
            <div class="grid grid-cols-2 gap-2">
                <button disabled class="bg-red-600 text-white py-2 rounded cursor-not-allowed border-none font-semibold">✕ REJECTED</button>
                <button onclick="updateJpStatus(${id}, 'Pending')" class="bg-gray-500 text-white py-2 rounded hover:bg-gray-600 transition cursor-pointer border-none font-semibold">Undo</button>
            </div>`;
    }
    if (status === 'OnHold') {
        return `
            <div class="grid grid-cols-3 gap-2">
                <button disabled class="bg-orange-500 text-white py-2 rounded cursor-not-allowed border-none font-semibold">⏸ HOLD</button>
                <button onclick="updateJpStatus(${id}, 'Approved')" class="bg-green-600 text-white py-2 rounded hover:bg-green-700 transition cursor-pointer border-none font-semibold">✓ ACCEPT</button>
                <button onclick="updateJpStatus(${id}, 'Rejected')" class="bg-red-600 text-white py-2 rounded hover:bg-red-700 transition cursor-pointer border-none font-semibold">✕ DECLINE</button>
            </div>`;
    }
    // Pending
    return `
        <div class="grid grid-cols-3 gap-2">
            <button onclick="updateJpStatus(${id}, 'Rejected')" class="bg-red-600 text-white py-2 rounded hover:bg-red-700 transition cursor-pointer border-none font-semibold">✕ DECLINE</button>
            <button onclick="updateJpStatus(${id}, 'OnHold')" class="bg-orange-500 text-white py-2 rounded hover:bg-orange-600 transition cursor-pointer border-none font-semibold">⏸ HOLD</button>
            <button onclick="updateJpStatus(${id}, 'Approved')" class="bg-green-600 text-white py-2 rounded hover:bg-green-700 transition cursor-pointer border-none font-semibold">✓ ACCEPT</button>
        </div>`;
}

async function updateJpStatus(id, newStatus) {
    try {
        const res = await authFetch(`/api/company/job-postings/${id}/status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: newStatus })
        });
        const result = await res.json();

        if (result.success) {
            // Update card UI
            const card = document.getElementById('jp-' + id);
            if (card) {
                card.dataset.status = newStatus;
                // Update status badge
                const header = card.querySelector('.flex.items-center.gap-4.mb-3');
                const oldBadge = header.querySelector('span');
                if (oldBadge) oldBadge.remove();
                header.insertAdjacentHTML('beforeend', getStatusBadge(newStatus));
                // Update action buttons
                document.getElementById('actions-' + id).innerHTML = getActionButtons(id, newStatus);
            }
            // Re-apply filters
            filterCards();
        } else {
            alert(result.message || 'Failed to update status.');
        }
    } catch (err) {
        alert('Network error. Please try again.');
        console.error(err);
    }
}
</script>
}