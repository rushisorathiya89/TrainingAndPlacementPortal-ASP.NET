@{ ViewData["Title"] = "Company Dashboard"; }

<div class="w-full">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-red-600">Company Dashboard</h1>
            <p class="text-gray-600">Track and manage your active job drives and applicants.</p>
        </div>
    </div>

    <!-- Statistics -->
    <div id="companyStats" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-xl">
                <i class="fas fa-briefcase"></i>
            </div>
            <div>
                <p class="text-gray-500 text-xs font-bold uppercase m-0">Active Drives</p>
                <h3 id="stat-activeDrives" class="text-2xl font-bold m-0">...</h3>
            </div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center text-xl">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <p class="text-gray-500 text-xs font-bold uppercase m-0">Total Applicants</p>
                <h3 id="stat-totalApplicants" class="text-2xl font-bold m-0">...</h3>
            </div>
        </div>
    </div>

    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <i class="fas fa-list text-red-600"></i> My Job Postings
    </h2>

    <!-- Loading State -->
    <div id="jobsLoading" class="text-center py-12">
        <i class="fas fa-spinner fa-spin text-3xl text-red-500"></i>
        <p class="text-gray-500 mt-3">Fetching your job postings...</p>
    </div>

    <!-- Empty State -->
    <div id="jobsEmpty" class="hidden text-center py-12 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
        <i class="fas fa-folder-open text-5xl text-gray-300 mb-4"></i>
        <p class="text-gray-500">You haven't posted any jobs yet.</p>
        <button onclick="window.location.href='/Home/SubmitJd'" class="mt-4 bg-red-600 text-white px-6 py-2 rounded-lg font-bold border-none cursor-pointer">Submit New JD</button>
    </div>

    <!-- Jobs Grid -->
    <div id="jobsGrid" class="grid grid-cols-1 lg:grid-cols-2 gap-6 hidden">
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Company')) return;
    loadCompanyJobs();
});

async function loadCompanyJobs() {
    const grid = document.getElementById('jobsGrid');
    const loading = document.getElementById('jobsLoading');
    const empty = document.getElementById('jobsEmpty');

    try {
        const res = await authFetch('/api/company/my-jobs');
        const result = await res.json();

        loading.classList.add('hidden');

        if (!result.success || !result.data || result.data.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        grid.classList.remove('hidden');
        grid.innerHTML = '';

        let totalApps = 0;
        let activeDrives = 0;

        result.data.forEach(j => {
            totalApps += j.applicantCount;
            if (j.status === 'Approved' && j.isActive) activeDrives++;

            const card = document.createElement('div');
            card.className = 'bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition';
            
            const date = new Date(j.postedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short' });
            const statusClass = j.status === 'Approved' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700';

            card.innerHTML = `
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h3 class="text-lg font-bold text-gray-800 m-0">${j.jobPosition}</h3>
                        <p class="text-red-600 font-bold m-0">${j.annualCTC}</p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold ${statusClass}">${j.status}</span>
                </div>
                
                <div class="flex items-center gap-4 text-sm text-gray-500 mb-6 font-medium">
                    <span><i class="far fa-calendar-alt mr-1"></i> Posted: ${date}</span>
                    <span><i class="fas fa-users mr-1"></i> ${j.applicantCount} Applicants</span>
                </div>

                <div class="flex gap-3 pt-2">
                    <a href="/Company/AppliedStudents?jobId=${j.id}" class="flex-1 bg-red-600 text-white text-center py-2 rounded-lg font-bold no-underline hover:bg-red-700 transition">
                        MANAGE APPLICANTS
                    </a>
                </div>
            `;
            grid.appendChild(card);
        });

        document.getElementById('stat-activeDrives').innerText = activeDrives;
        document.getElementById('stat-totalApplicants').innerText = totalApps;

    } catch (err) {
        console.error('Failed to load company jobs:', err);
        loading.classList.add('hidden');
        empty.classList.remove('hidden');
        empty.querySelector('p').innerText = 'Something went wrong. Please try again.';
    }
}
</script>
}
