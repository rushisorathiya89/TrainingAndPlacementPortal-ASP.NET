@{
    ViewData["Title"] = "Submit JD";
    Layout = "_AuthLayout";
}

<section class="bg-gray-100 min-h-screen py-12">
    <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-gray-800">Campus Placement Registration</h2>
            <p class="text-gray-500 text-sm mt-2">RK University, Rajkot – Training &amp; Placement Cell</p>
        </div>

        <form id="jdForm" onsubmit="event.preventDefault(); submitJdToApi();" class="space-y-6">
            <!-- Contact Information -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2">
                    <i class="fas fa-address-book"></i> Contact Information
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-gray-100 p-4 rounded-lg">
                        <p class="font-semibold">Dr. Vishal Doshi</p>
                        <p class="text-sm text-gray-600">Head of Training &amp; Placement Cell</p>
                        <p class="text-sm">+91 98765 43210</p>
                    </div>
                    <div class="bg-gray-100 p-4 rounded-lg">
                        <p class="font-semibold">Mr. Osho Shah</p>
                        <p class="text-sm text-gray-600">Assistant Training &amp; Placement Officer</p>
                        <p class="text-sm">+91 87654 32109</p>
                    </div>
                </div>
            </div>

            <!-- Company Details -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2">
                    <i class="fas fa-building"></i> Company Details
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Company Name *</label>
                        <input type="text" id="companyName" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. Multiicon" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Company Primary Email *</label>
                        <input type="email" id="email" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. info@multiicon.in" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Website *</label>
                        <input type="url" id="website" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. https://multiicon.in" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Job Location</label>
                        <input type="text" id="jobLocation" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. Rajkot / Remote" />
                    </div>
                </div>
            </div>

            <!-- Contact Person Details -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2">
                    <i class="fas fa-user-tie"></i> HR / Contact Person
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Contact Name *</label>
                        <input type="text" id="contactName" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. Shweta Jethwa" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Contact Email *</label>
                        <input type="email" id="contactEmail" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. hr@multiicon.in" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Contact Mobile *</label>
                        <input type="text" id="contactMobile" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. 9876543210" required />
                    </div>
                </div>
            </div>

            <!-- Job Details -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2">
                    <i class="fas fa-briefcase"></i> Job details & Dates
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Job Position *</label>
                        <input type="text" id="jobPosition" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. PHP Developer" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Annual CTC *</label>
                        <input type="text" id="annualCtc" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. ₹3.6 LPA" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Expected Date of Joining *</label>
                        <input type="date" id="dateOfJoining" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Campus Drive Date *</label>
                        <input type="date" id="campusDriveDate" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Internship Duration</label>
                        <input type="text" id="internshipDuration" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. 6 Months" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Stipend</label>
                        <input type="text" id="stipend" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. ₹10,000" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Selection Process *</label>
                        <textarea id="selectionProcess" rows="3" class="w-full p-3 rounded-lg border border-gray-300 outline-none focus:ring-2 focus:ring-red-500" placeholder="e.g. Aptitude Test + Technical Round + HR" required></textarea>
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full bg-red-600 text-white font-bold py-4 rounded-xl hover:bg-red-700 transition shadow-lg">
                Submit Job Description
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        async function submitJdToApi() {
            const dto = {
                companyName: document.getElementById('companyName').value,
                email: document.getElementById('email').value,
                website: document.getElementById('website').value,
                jobLocation: document.getElementById('jobLocation').value,
                contactName: document.getElementById('contactName').value,
                contactEmail: document.getElementById('contactEmail').value,
                contactMobile: document.getElementById('contactMobile').value,
                jobPosition: document.getElementById('jobPosition').value,
                annualCtc: document.getElementById('annualCtc').value,
                internshipDuration: document.getElementById('internshipDuration').value,
                stipend: document.getElementById('stipend').value,
                dateOfJoining: document.getElementById('dateOfJoining').value,
                campusDriveDate: document.getElementById('campusDriveDate').value,
                selectionProcess: document.getElementById('selectionProcess').value,
                bond: "N/A",
                registrationLink: "N/A",
                additionalNotes: "N/A"
            };

            try {
                const submitBtn = document.querySelector('button[type="submit"]');
                const originalText = submitBtn.textContent;
                submitBtn.textContent = 'Submitting...';
                submitBtn.disabled = true;

                const response = await fetch('/api/company/submit-jd', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(result.message);
                    window.location.href = '/Home/Index';
                } else {
                    alert('Error: ' + (result.message || 'Validation failed.'));
                }
            } catch (err) {
                alert('An error occurred while submitting JD.');
                console.error(err);
            } finally {
                const submitBtn = document.querySelector('button[type="submit"]');
                submitBtn.textContent = 'Submit Job Description';
                submitBtn.disabled = false;
            }
        }
    </script>
}
