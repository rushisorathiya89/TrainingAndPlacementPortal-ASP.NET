@{
    ViewData["Title"] = "Student Registration";
    Layout = "_AuthLayout";
}

<section class="bg-gray-100 min-h-screen py-12 relative">
    <!-- Back to Home Button -->
    <a href="/" class="absolute top-6 right-6 bg-white text-gray-700 border border-gray-300 px-4 py-2 rounded-md shadow-sm hover:bg-gray-50 transition flex items-center font-medium text-sm no-underline">
        <i class="fas fa-arrow-left mr-2"></i> Back to Home
    </a>

    <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-gray-800">Student Registration</h2>
            <p class="text-gray-500 text-sm mt-2">Fill out the form below to register for Placements.</p>
        </div>

        <!-- Success/Error Messages -->
        <div id="regSuccessMsg" class="hidden mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-xl text-sm text-center"></div>
        <div id="regErrorMsg" class="hidden mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-xl text-sm text-center"></div>

        <form id="studentRegForm" onsubmit="return handleStudentRegistration(event)" class="space-y-6">
            <!-- Personal Information -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2"><i class="fas fa-user"></i> Personal Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Enrollment Number *</label>
                        <input type="text" id="enrollment" name="enrollmentNumber" class="w-full p-3 border rounded-lg" placeholder="Enter enrollment number" oninput="validateRegField('enrollment')" />
                        <p id="enrollmentError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                        <input type="text" id="name" name="fullName" class="w-full p-3 border rounded-lg" placeholder="Enter full name" oninput="validateRegField('name')" />
                        <p id="nameError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Branch *</label>
                        <select id="branch" name="branch" class="w-full p-3 border rounded-lg" onchange="validateRegField('branch')">
                            <option value="">Select Branch</option>
                            <option>Computer Engineering</option>
                            <option>Information Technology</option>
                            <option>Mechanical Engineering</option>
                            <option>Civil Engineering</option>
                            <option>Electrical Engineering</option>
                        </select>
                        <p id="branchError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Semester *</label>
                        <select id="semester" name="semester" class="w-full p-3 border rounded-lg" onchange="validateRegField('semester')">
                            <option value="">Select Semester</option>
                            <option>1st</option><option>2nd</option><option>3rd</option><option>4th</option>
                            <option>5th</option><option>6th</option><option>7th</option><option>8th</option>
                        </select>
                        <p id="semesterError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">University Email *</label>
                        <input type="email" id="universityEmail" name="email" class="w-full p-3 border rounded-lg" placeholder="Enter university email" oninput="validateRegField('universityEmail')" />
                        <p id="universityEmailError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Personal Email *</label>
                        <input type="email" id="personalEmail" name="personalEmail" class="w-full p-3 border rounded-lg" placeholder="Enter personal email" oninput="validateRegField('personalEmail')" />
                        <p id="personalEmailError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Password *</label>
                        <input type="password" id="password" name="password" class="w-full p-3 border rounded-lg" placeholder="Enter password (min 6 characters)" oninput="validateRegField('password')" />
                        <p id="passwordError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password *</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="w-full p-3 border rounded-lg" placeholder="Confirm password" oninput="validateRegField('confirmPassword')" />
                        <p id="confirmPasswordError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Mobile Number *</label>
                        <input type="text" id="mobile" name="mobileNumber" class="w-full p-3 border rounded-lg" placeholder="Enter mobile number" oninput="validateRegField('mobile')" />
                        <p id="mobileError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                </div>
            </div>

            <!-- Academic Details -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2"><i class="fas fa-book"></i> Academic Details</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">10th Percentage *</label>
                        <input type="number" step="0.01" id="tenth" name="tenthPercentage" class="w-full p-3 border rounded-lg" placeholder="Enter %" oninput="validateRegField('tenth')" />
                        <p id="tenthError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">12th Percentage *</label>
                        <input type="number" step="0.01" id="twelfth" name="twelfthPercentage" class="w-full p-3 border rounded-lg" placeholder="Enter %" oninput="validateRegField('twelfth')" />
                        <p id="twelfthError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">CGPA *</label>
                        <input type="number" step="0.01" id="cgpa" name="cgpa" class="w-full p-3 border rounded-lg" placeholder="Enter CGPA" oninput="validateRegField('cgpa')" />
                        <p id="cgpaError" class="text-red-500 text-xs mt-1 hidden"></p>
                    </div>
                </div>
            </div>

            <!-- Parent Info -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2"><i class="fas fa-users"></i> Parent Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">Parent Name *</label><input type="text" id="parentName" name="parentName" class="w-full p-3 border rounded-lg" oninput="validateRegField('parentName')" /><p id="parentNameError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">Parent Email *</label><input type="email" id="parentEmail" name="parentEmail" class="w-full p-3 border rounded-lg" oninput="validateRegField('parentEmail')" /><p id="parentEmailError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">Parent Mobile *</label><input type="text" id="parentMobile" name="parentMobile" class="w-full p-3 border rounded-lg" oninput="validateRegField('parentMobile')" /><p id="parentMobileError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                </div>
            </div>

            <!-- Address -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2"><i class="fas fa-map-marker-alt"></i> Address</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Current Address *</label><textarea id="currentAddress" name="currentAddress" class="w-full p-3 border rounded-lg" rows="2" oninput="validateRegField('currentAddress')"></textarea><p id="currentAddressError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                    <div class="md:col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Permanent Address *</label><textarea id="permanentAddress" name="permanentAddress" class="w-full p-3 border rounded-lg" rows="2" oninput="validateRegField('permanentAddress')"></textarea><p id="permanentAddressError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">City *</label><input type="text" id="city" name="city" class="w-full p-3 border rounded-lg" oninput="validateRegField('city')" /><p id="cityError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">State *</label><input type="text" id="state" name="state" class="w-full p-3 border rounded-lg" oninput="validateRegField('state')" /><p id="stateError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">Pincode *</label><input type="text" id="pincode" name="pincode" class="w-full p-3 border rounded-lg" oninput="validateRegField('pincode')" /><p id="pincodeError" class="text-red-500 text-xs mt-1 hidden"></p></div>
                </div>
            </div>

            <!-- Consent & Payment -->
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h3 class="text-lg font-bold text-red-600 mb-4 flex items-center gap-2"><i class="fas fa-upload"></i> Consent & Payment</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">Consent Form (PDF) *</label><input type="file" accept=".pdf" class="w-full p-3 border rounded-lg" /></div>
                    <div><label class="block text-sm font-medium text-gray-700 mb-1">Payment Proof (Image) *</label><input type="file" accept="image/*" class="w-full p-3 border rounded-lg" /></div>
                </div>
                <p class="text-xs text-gray-400 mt-2"><i class="fas fa-info-circle"></i> File uploads will be processed in a future update.</p>
            </div>

            <!-- Buttons -->
            <div class="flex flex-col items-center gap-3 pb-6">
                <div id="regSpinner" class="hidden">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-red-600 mx-auto"></div>
                    <p class="text-sm text-gray-500 mt-2">Submitting your registration...</p>
                </div>
                <div id="regButtons" class="flex flex-col sm:flex-row justify-center gap-3 w-full sm:w-auto">
                    <button type="button" onclick="clearForm('studentRegForm')" class="px-10 py-3 border border-gray-300 rounded-md font-medium hover:bg-gray-50 transition w-full sm:w-auto bg-white cursor-pointer">Clear Form</button>
                    <button type="submit" id="regSubmitBtn" class="bg-red-600 hover:bg-red-700 text-white px-10 py-3 rounded-md font-medium shadow transition w-full sm:w-auto border-none cursor-pointer">Submit Form</button>
                </div>
                <p class="text-xs text-gray-400 mt-3 text-center max-w-md mx-auto">After registration, admin will verify your payment and eligibility criteria. After verification you can access the portal.</p>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
async function handleStudentRegistration(event) {
    event.preventDefault();

    const successMsg = document.getElementById('regSuccessMsg');
    const errorMsg = document.getElementById('regErrorMsg');
    const spinner = document.getElementById('regSpinner');
    const buttons = document.getElementById('regButtons');

    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    // Build the request body from form fields
    const data = {
        enrollmentNumber: document.getElementById('enrollment').value.trim(),
        fullName: document.getElementById('name').value.trim(),
        branch: document.getElementById('branch').value,
        semester: document.getElementById('semester').value,
        email: document.getElementById('universityEmail').value.trim(),
        personalEmail: document.getElementById('personalEmail').value.trim(),
        password: document.getElementById('password').value,
        confirmPassword: document.getElementById('confirmPassword').value,
        mobileNumber: document.getElementById('mobile').value.trim(),
        tenthPercentage: parseFloat(document.getElementById('tenth').value) || 0,
        twelfthPercentage: parseFloat(document.getElementById('twelfth').value) || 0,
        cgpa: parseFloat(document.getElementById('cgpa').value) || 0,
        parentName: document.getElementById('parentName').value.trim(),
        parentEmail: document.getElementById('parentEmail').value.trim(),
        parentMobile: document.getElementById('parentMobile').value.trim(),
        currentAddress: document.getElementById('currentAddress').value.trim(),
        permanentAddress: document.getElementById('permanentAddress').value.trim(),
        city: document.getElementById('city').value.trim(),
        state: document.getElementById('state').value.trim(),
        pincode: document.getElementById('pincode').value.trim()
    };

    // Client-side validation
    if (!data.enrollmentNumber || !data.fullName || !data.branch || !data.semester ||
        !data.email || !data.password || !data.mobileNumber) {
        errorMsg.textContent = 'Please fill all required fields.';
        errorMsg.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return false;
    }

    if (data.password.length < 6) {
        errorMsg.textContent = 'Password must be at least 6 characters.';
        errorMsg.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return false;
    }

    if (data.password !== data.confirmPassword) {
        errorMsg.textContent = 'Passwords do not match.';
        errorMsg.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return false;
    }

    // Show spinner, hide buttons
    spinner.classList.remove('hidden');
    buttons.classList.add('hidden');

    try {
        const response = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.ok && result.success) {
            successMsg.textContent = result.message;
            successMsg.classList.remove('hidden');
            document.getElementById('studentRegForm').reset();
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Redirect to login after 3 seconds
            setTimeout(() => {
                window.location.href = '/Auth/Login';
            }, 3000);
        } else {
            let msg = result.message || 'Registration failed.';
            if (result.errors && result.errors.length > 0) {
                msg += ' ' + result.errors.join(', ');
            }
            if (result.error) {
                msg += ' (' + result.error + ')';
            }
            errorMsg.textContent = msg;
            errorMsg.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    } catch (err) {
        errorMsg.textContent = 'Connection error. Please check your network and try again. Details: ' + err.message;
        errorMsg.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    } finally {
        spinner.classList.add('hidden');
        buttons.classList.remove('hidden');
    }

    return false;
}
</script>
}
