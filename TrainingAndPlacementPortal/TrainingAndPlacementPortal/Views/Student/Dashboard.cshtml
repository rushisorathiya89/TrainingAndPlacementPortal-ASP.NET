@{ ViewData["Title"] = "Student Dashboard"; }

<div class="w-full">
    <header class="page-header flex justify-between items-start mb-8">
        <div>
            <h1 id="welcomeTitle" class="text-2xl md:text-3xl font-bold text-gray-900 m-0">Welcome Student</h1>
            <p class="text-gray-600 text-sm md:text-base m-0 mt-1">Here's your placement dashboard overview</p>
        </div>
    </header>

    <!-- Status Cards -->
    <section id="studentStatsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <!-- Stats will load here -->
        <div class="col-span-full py-10 text-center text-gray-400">Loading your profile status...</div>
    </section>

    <!-- Quick Actions -->
    <section>
        <h2 class="text-2xl font-bold mb-6 text-gray-900 m-0 uppercase tracking-tight">Quick Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var action in new[] {
                new { Title = "Browse Jobs", Desc = "Explore available opportunities", Link = "View Jobs", Href = "/StudJobs", Icon = "🔍", Color = "bg-[#dbeafe] text-blue-600" },
                new { Title = "My Applied", Desc = "Track application status", Link = "View Applied", Href = "/StudApplications", Icon = "📋", Color = "bg-[#fefce8] text-yellow-600" },
                new { Title = "Profile", Desc = "Update your information", Link = "Edit Profile", Href = "/StudProfile", Icon = "👤", Color = "bg-[#f3e8ff] text-purple-600" },
                new { Title = "Interviews", Desc = "Manage interview schedule", Link = "View Schedule", Href = "/StudInterviewSchedule", Icon = "🗓️", Color = "bg-[#fef2f2] text-red-600" }
            })
            {
                <a href="@action.Href" class="bg-[#ece6da] border border-[#e0dacd] p-6 rounded-2xl shadow-sm transition-all hover:shadow-md hover:scale-[1.02] flex flex-col items-center text-center no-underline text-inherit group">
                    <div class="w-16 h-16 @action.Color rounded-2xl flex items-center justify-center mb-4 text-3xl shadow-sm group-hover:scale-110 transition-transform">@action.Icon</div>
                    <h3 class="text-lg font-bold my-2 text-gray-900">@action.Title</h3>
                    <p class="text-gray-600 text-xs font-semibold mb-5 leading-snug w-full">@action.Desc</p>
                    <span class="text-[#e7000b] font-bold text-xs uppercase tracking-wider mt-auto group-hover:underline">@action.Link ➔</span>
                </a>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Student')) return;
            
            // Set name from localStorage
            const fullName = localStorage.getItem('tp_fullName') || 'Student';
            document.getElementById('welcomeTitle').textContent = `Welcome, ${fullName}`;
            
            await loadStudentDashboard();
        });

        async function loadStudentDashboard() {
            try {
                const res = await authFetch('/api/applications/stats');
                if (!res || !res.ok) throw new Error('Failed to fetch student stats');
                const result = await res.json();
                
                if (result.success) {
                    renderStudentStats(result.data);
                }
            } catch (err) {
                console.error(err);
                document.getElementById('studentStatsGrid').innerHTML = '<p class="text-red-500 col-span-full">Failed to load dashboard data.</p>';
            }
        }

        function renderStudentStats(data) {
            const stats = [
                { title: "T&P Status", value: "APPROVED", desc: "Registration Approved", icon: "✅", color: "text-green-700", bg: "bg-[#e8f5e9]", valBg: "bg-[#d8cfc3]" },
                { title: "Applied", value: data.totalApplications, desc: "Job Applications", icon: "💼", color: "text-blue-700", bg: "bg-blue-100", valBg: "bg-[#d8cfc3]" },
                { title: "Shortlisted", value: data.shortlisting, desc: "Process Ongoing", icon: "🎯", color: "text-purple-700", bg: "bg-purple-100", valBg: "bg-[#d8cfc3]" },
                { title: "Interviews", value: data.upcomingInterviews, desc: "Upcoming Rounds", icon: "🗓️", color: "text-orange-700", bg: "bg-orange-100", valBg: "bg-[#d8cfc3]" }
            ];

            let html = '';
            stats.forEach(s => {
                html += `
                <div class="bg-[#ece6da] p-6 rounded-2xl border border-[#e0dacd] shadow-sm flex flex-col transition-all hover:shadow-md">
                    <div class="flex justify-between items-start mb-5">
                        <div class="text-2xl p-2.5 ${s.valBg} rounded-xl shadow-sm">${s.icon}</div>
                        <span class="font-extrabold text-[10px] px-2.5 py-1 rounded-full uppercase tracking-wider ${s.bg} ${s.color}">${s.value}</span>
                    </div>
                    <h3 class="m-0 text-xl font-extrabold text-gray-900">${s.title}</h3>
                    <p class="mt-1 text-xs font-bold text-gray-500 m-0 uppercase tracking-tight">${s.desc}</p>
                </div>`;
            });

            document.getElementById('studentStatsGrid').innerHTML = html;
        }
    </script>
}
