@{ ViewData["Title"] = "Job Details"; }

<div class="w-full">
    <div class="page-header">
        <h1 class="page-title">Company Job Description</h1>
        <p class="page-subtitle">Read All Information Properly Before Apply</p>
    </div>

    <!-- Loading -->
    <div id="jobDetailLoading" class="text-center py-12">
        <i class="fas fa-spinner fa-spin text-3xl text-red-500"></i>
        <p class="text-gray-500 mt-3">Loading job details...</p>
    </div>

    <!-- Content -->
    <div id="jobDetailContent" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Section -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Header Card -->
                <div class="bg-[#ece6da] p-6 rounded-lg border border-[#e0dacd] shadow-sm flex items-center gap-6">
                    <div id="jdInitial" class="w-16 h-16 bg-blue-500 rounded-xl shadow-sm flex items-center justify-center shrink-0 text-white font-bold text-3xl">?</div>
                    <div>
                        <h2 id="jdTitle" class="text-2xl font-bold text-gray-900 m-0 mb-2"></h2>
                        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-700 font-medium">
                            <div class="flex items-center gap-1.5"><span class="text-blue-600">🏢</span> <span id="jdCompName"></span></div>
                            <div class="flex items-center gap-1.5"><span class="text-blue-600">📍</span> <span id="jdLoc"></span></div>
                            <div class="flex items-center gap-1.5"><span class="text-blue-600">🌐</span> <a id="jdWeb" href="#" target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-700 no-underline"></a></div>
                        </div>
                    </div>
                </div>

                <!-- Metrics -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div class="bg-[#eafdf0] rounded-xl p-5 shadow-sm border border-[#d1f4da]">
                        <div id="jdCtc" class="text-green-600 text-lg font-bold mb-1"></div>
                        <div class="text-gray-600 text-sm font-medium">Annual CTC</div>
                    </div>
                    <div class="bg-[#eff6ff] rounded-xl p-5 shadow-sm border border-[#dbeafe]">
                        <div id="jdStipendVal" class="text-blue-700 text-lg font-bold mb-1">-</div>
                        <div class="text-gray-600 text-sm font-medium">Stipend</div>
                    </div>
                    <div class="bg-[#fefce8] rounded-xl p-5 shadow-sm border border-[#fef08a]">
                        <div id="jdInternVal" class="text-yellow-700 text-lg font-bold mb-1">-</div>
                        <div class="text-gray-600 text-sm font-medium">Internship</div>
                    </div>
                    <div class="bg-[#fef2f2] rounded-xl p-5 shadow-sm border border-[#fecaca]">
                        <div id="jdBondVal" class="text-red-700 text-lg font-bold mb-1">-</div>
                        <div class="text-gray-600 text-sm font-medium">Bond</div>
                    </div>
                </div>

                <!-- Description Content -->
                <div class="bg-[#ece6da] p-6 rounded-lg border border-[#e0dacd] shadow-sm">
                    <div class="mb-6">
                        <h3 class="text-lg font-bold text-gray-900 mb-3 border-b border-gray-300 pb-2 m-0">About Company &amp; Job Description</h3>
                        <p id="jdDesc" class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap m-0"></p>
                    </div>

                    <div class="mb-6">
                        <h3 class="text-lg font-bold text-gray-900 mb-3 border-b border-gray-300 pb-2 m-0">Selection Process</h3>
                        <p id="jdProcess" class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap m-0"></p>
                    </div>

                    <div id="jdNotesSection">
                        <h3 class="text-lg font-bold text-gray-900 mb-3 border-b border-gray-300 pb-2 m-0">Additional Information</h3>
                        <p id="jdNotes" class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap m-0"></p>
                    </div>
                </div>
            </div>

            <!-- Right Section -->
            <div class="lg:col-span-1 space-y-6">

                <div class="bg-[#ece6da] p-6 rounded-lg border border-[#e0dacd] shadow-sm">
                    <h3 class="text-lg font-bold text-gray-900 mb-4 m-0">Eligibility &amp; Dates</h3>

                    <div class="space-y-4">
                        <div>
                            <div class="text-sm font-bold text-gray-900">Eligible Courses</div>
                            <div id="jdCourses" class="text-sm text-gray-600"></div>
                        </div>
                        <div>
                            <div class="text-sm font-bold text-gray-900">Eligible Batches</div>
                            <div id="jdBatches" class="text-sm text-gray-600"></div>
                        </div>
                        <div>
                            <div class="text-sm font-bold text-gray-900">Drive Date</div>
                            <div id="jdDriveDate" class="text-sm text-gray-600"></div>
                        </div>
                        <div>
                            <div class="text-sm font-bold text-gray-900">Tentative Joining Date</div>
                            <div id="jdJoinDate" class="text-sm text-gray-600"></div>
                        </div>
                        <div id="jdRegLinkSection" class="hidden">
                            <div class="text-sm font-bold text-gray-900">Registration Link</div>
                            <a id="jdRegLink" href="#" target="_blank" class="text-sm text-blue-600 hover:underline break-all"></a>
                        </div>
                    </div>
                </div>

                <div class="pt-2 flex flex-col items-center">
                    <button id="applyNowBtn" onclick="applyJob('applyNowBtn')" class="w-full py-4 rounded-xl font-bold text-white uppercase bg-[#e7000b] hover:bg-red-700 transition-colors shadow-md flex items-center justify-center gap-2 mb-3 border-none cursor-pointer">
                        APPLY NOW <span class="text-xl leading-none">→</span>
                    </button>
                    <a href="/Student/Jobs" class="text-sm text-gray-500 hover:text-gray-700 no-underline">← Back to All Jobs</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!requireAuth('Student')) return;

    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    if (!id) {
        window.location.href = '/Student/Jobs';
        return;
    }
    loadJobDetail(id);
});

async function loadJobDetail(id) {
    const loading = document.getElementById('jobDetailLoading');
    const content = document.getElementById('jobDetailContent');

    try {
        const res = await authFetch(`/api/company/approved-jobs/${id}`);
        const result = await res.json();

        loading.classList.add('hidden');

        if (!result.success || !result.data) {
            alert('Job not found or no longer available.');
            window.location.href = '/Student/Jobs';
            return;
        }

        const job = result.data;

        // Header
        document.getElementById('jdInitial').textContent = job.companyName ? job.companyName.charAt(0).toUpperCase() : '?';
        document.getElementById('jdTitle').textContent = job.jobPosition;
        document.getElementById('jdCompName').textContent = job.companyName;
        document.getElementById('jdLoc').textContent = job.jobLocation || 'N/A';
        
        const webEl = document.getElementById('jdWeb');
        if (job.website) {
            webEl.textContent = job.website.replace(/^https?:\/\//, '');
            webEl.href = job.website.startsWith('http') ? job.website : 'https://' + job.website;
        } else {
            webEl.textContent = 'N/A';
        }

        // Metrics
        document.getElementById('jdCtc').textContent = job.annualCTC || '-';
        document.getElementById('jdStipendVal').textContent = job.stipend || '-';
        document.getElementById('jdInternVal').textContent = job.internshipDuration || '-';
        document.getElementById('jdBondVal').textContent = job.bond || '-';

        // Description
        document.getElementById('jdDesc').textContent = job.description || 'No description provided.';
        document.getElementById('jdProcess').textContent = job.selectionProcess || 'Not specified.';
        
        const notes = job.additionalNotes;
        if (notes) {
            document.getElementById('jdNotes').textContent = notes;
        } else {
            document.getElementById('jdNotesSection').classList.add('hidden');
        }

        // Eligibility
        document.getElementById('jdCourses').textContent = job.eligibleCourses ? job.eligibleCourses.replace(/,/g, ', ') : 'All courses';
        document.getElementById('jdBatches').textContent = job.eligibleBatches ? job.eligibleBatches.replace(/,/g, ', ') : 'All batches';

        // Dates
        document.getElementById('jdDriveDate').textContent = job.campusDriveDate ? new Date(job.campusDriveDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : 'TBD';
        document.getElementById('jdJoinDate').textContent = job.dateOfJoining ? new Date(job.dateOfJoining).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : 'TBD';

        // Registration Link
        if (job.registrationLink) {
            document.getElementById('jdRegLinkSection').classList.remove('hidden');
            const regLink = document.getElementById('jdRegLink');
            regLink.href = job.registrationLink.startsWith('http') ? job.registrationLink : 'https://' + job.registrationLink;
            regLink.textContent = job.registrationLink;
        }

        // Apply Button API setup
        const applyBtn = document.getElementById('applyNowBtn');
        applyBtn.onclick = () => applyJobApi(job.id, 'applyNowBtn');

        // Check if already applied
        try {
            const checkRes = await authFetch(`/api/applications/check/${job.id}`);
            const checkResult = await checkRes.json();
            if (checkResult.success && checkResult.hasApplied) {
                applyBtn.textContent = 'APPLIED ✅';
                applyBtn.className = 'w-full py-4 rounded-xl font-bold text-green-800 uppercase bg-green-100 cursor-not-allowed shadow-md flex items-center justify-center gap-2 mb-3 border-none';
                applyBtn.disabled = true;
            }
        } catch (e) {
            console.error('Failed to check application status:', e);
        }

        content.classList.remove('hidden');

    } catch (err) {
        loading.classList.add('hidden');
        alert('Failed to load job details.');
        console.error(err);
    }
}
</script>
}
