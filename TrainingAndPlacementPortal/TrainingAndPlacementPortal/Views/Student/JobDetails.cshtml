@{ ViewData["Title"] = "Job Details"; }

<div class="w-full">
    <div class="page-header">
        <h1 class="page-title">Company Job Description</h1>
        <p class="page-subtitle">Read All Information Properly Before Apply</p>
    </div>

<div id="loadingIndicator" class="flex justify-center items-center py-20">
    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600"></div>
</div>

<div id="jobDetailContent" class="hidden">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Section -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Header Card -->
            <div class="bg-[#ece6da] p-6 rounded-2xl border border-[#e0dacd] shadow-sm flex items-center gap-6">
                <div id="companyLogo" class="w-16 h-16 bg-[#2563eb] rounded-2xl shadow-sm flex items-center justify-center shrink-0 text-white font-bold text-3xl">L</div>
                <div>
                    <h2 id="jobTitle" class="text-2xl font-bold text-gray-900 m-0 mb-2">Job Title</h2>
                    <div class="flex flex-wrap items-center gap-4 text-sm text-gray-700 font-bold">
                        <div class="flex items-center gap-1.5"><span class="text-blue-600">🏢</span> <span id="companyNameHeader">Company Name</span></div>
                        <div class="flex items-center gap-1.5"><span class="text-blue-600">📍</span> <span id="jobLocationHeader">Location</span></div>
                        <div id="websiteContainer" class="flex items-center gap-1.5"><span class="text-blue-600">🌐</span> <a id="companyWebsite" href="" target="_blank" class="hover:underline text-gray-700 no-underline">website</a></div>
                    </div>
                </div>
            </div>

            <!-- Metrics -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="bg-[#eafdf0] rounded-2xl p-5 shadow-sm border border-[#d1f4da]">
                    <div id="ctcMetric" class="text-green-600 text-lg font-extrabold mb-1">N/A</div>
                    <div class="text-gray-600 text-xs font-bold uppercase tracking-wider">Annual CTC</div>
                </div>
                <div class="bg-[#eff6ff] rounded-2xl p-5 shadow-sm border border-[#dbeafe]">
                    <div id="stipendMetric" class="text-blue-700 text-lg font-extrabold mb-1">N/A</div>
                    <div class="text-gray-600 text-xs font-bold uppercase tracking-wider">Stipend</div>
                </div>
                <div class="bg-[#fefce8] rounded-2xl p-5 shadow-sm border border-[#fef08a]">
                    <div id="durationMetric" class="text-yellow-700 text-lg font-extrabold mb-1">N/A</div>
                    <div class="text-gray-600 text-xs font-bold uppercase tracking-wider">Internship</div>
                </div>
                <div class="bg-[#fef2f2] rounded-2xl p-5 shadow-sm border border-[#fecaca]">
                    <div id="bondMetric" class="text-red-700 text-lg font-extrabold mb-1">N/A</div>
                    <div class="text-gray-600 text-xs font-bold uppercase tracking-wider">Bond</div>
                </div>
            </div>

            <!-- Description Content -->
            <div class="bg-[#ece6da] p-8 rounded-2xl border border-[#e0dacd] shadow-sm">
                <div class="mb-8">
                    <h3 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-300 pb-2 m-0 uppercase tracking-tight">About Company & Job Description</h3>
                    <p id="jobDescription" class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap m-0 font-medium">Description here...</p>
                </div>

                <div class="mb-8">
                    <h3 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-300 pb-2 m-0 uppercase tracking-tight">Selection Process</h3>
                    <p id="selectionProcess" class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap m-0 font-medium">Process here...</p>
                </div>

                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-300 pb-2 m-0 uppercase tracking-tight">Additional Information</h3>
                    <p id="additionalInfo" class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap m-0 font-medium">Notes here...</p>
                </div>
            </div>
        </div>

        <!-- Right Section -->
        <div class="lg:col-span-1 space-y-6">

            <div class="bg-[#ece6da] p-6 rounded-2xl border border-[#e0dacd] shadow-sm">
                <h3 class="text-lg font-bold text-gray-900 mb-5 m-0 uppercase tracking-tight">Eligibility & Dates</h3>

                <div class="space-y-5">
                    <div>
                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Eligible Courses</div>
                        <div id="eligibleCourses" class="text-sm text-gray-900 font-bold">N/A</div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Eligible Batches</div>
                        <div id="eligibleBatches" class="text-sm text-gray-900 font-bold">N/A</div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Drive Date</div>
                        <div id="driveDate" class="text-sm text-gray-900 font-bold">N/A</div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Tentative Joining Date</div>
                        <div id="joiningDate" class="text-sm text-gray-900 font-bold">N/A</div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Registration Link</div>
                        <div id="regLinkContainer" class="text-sm text-blue-600 font-bold break-all">
                             <a id="regLink" href="#" target="_blank" class="hover:underline">Link</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-2">
                <button id="applyBtn" onclick="applyFromDetail()" class="w-full py-4 rounded-xl font-bold text-white uppercase bg-[#e7000b] hover:bg-red-700 transition-all shadow-md active:scale-[0.98] border-none cursor-pointer text-sm">
                    APPLY NOW <span class="ml-2 text-xl leading-none">→</span>
                </button>
                <div class="mt-4 text-center">
                    <a href="/StudJobs" class="text-gray-500 text-sm font-bold no-underline hover:text-gray-700 flex items-center justify-center gap-1">
                        ← Back to All Jobs
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentJobId = null;

        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Student')) return;
            
            const params = new URLSearchParams(window.location.search);
            currentJobId = params.get('id');

            if (!currentJobId) {
                document.getElementById('loadingIndicator').innerHTML = '<p class="text-red-500 font-bold">Invalid Job ID.</p>';
                return;
            }

            await loadJobDetail();
        });

        async function loadJobDetail() {
            try {
                // Parallel fetch for job details and application status
                const [jobRes, appRes] = await Promise.all([
                    authFetch(`/api/company/approved-jobs/${currentJobId}`),
                    authFetch('/api/applications/my-applications')
                ]);

                if (!jobRes || !jobRes.ok) throw new Error('Job not found');
                const data = await jobRes.json();
                
                if (data.success) {
                    const job = data.data;
                    
                    // Populate UI
                    document.getElementById('jobTitle').textContent = job.jobPosition;
                    document.getElementById('companyNameHeader').textContent = job.companyName;
                    document.getElementById('jobLocationHeader').textContent = job.jobLocation;
                    document.getElementById('companyLogo').textContent = job.companyName.charAt(0).toUpperCase();
                    
                    if (job.website) {
                        document.getElementById('companyWebsite').href = job.website.startsWith('http') ? job.website : 'https://' + job.website;
                        document.getElementById('companyWebsite').textContent = job.website;
                    } else {
                        document.getElementById('websiteContainer').classList.add('hidden');
                    }

                    document.getElementById('ctcMetric').textContent = job.annualCTC || 'N/A';
                    document.getElementById('stipendMetric').textContent = job.stipend || 'N/A';
                    document.getElementById('durationMetric').textContent = job.internshipDuration || 'N/A';
                    document.getElementById('bondMetric').textContent = job.bond || 'N/A';
                    
                    document.getElementById('jobDescription').textContent = job.description || 'No description provided.';
                    document.getElementById('selectionProcess').textContent = job.selectionProcess || 'No details provided.';
                    document.getElementById('additionalInfo').textContent = job.additionalNotes || 'No additional information.';
                    
                    document.getElementById('eligibleCourses').textContent = job.eligibleCourses || 'All Courses';
                    document.getElementById('eligibleBatches').textContent = job.eligibleBatches || 'All Batches';
                    document.getElementById('driveDate').textContent = job.campusDriveDate ? new Date(job.campusDriveDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'To be announced';
                    document.getElementById('joiningDate').textContent = job.dateOfJoining ? new Date(job.dateOfJoining).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A';
                    
                    if (job.registrationLink) {
                        document.getElementById('regLink').href = job.registrationLink;
                        document.getElementById('regLink').textContent = job.registrationLink;
                    } else {
                        document.getElementById('regLinkContainer').textContent = 'N/A';
                    }

                    // Check if already applied or already placed
                    if (appRes && appRes.ok) {
                        const appData = await appRes.json();
                        const applications = appData.data || [];
                        const isApplied = applications.some(a => a.jobPostingId == currentJobId);
                        const isPlaced = applications.some(a => a.applicationStatus === 'Selected');
                        
                        const btn = document.getElementById('applyBtn');
                        
                        if (isApplied) {
                            btn.textContent = 'APPLIED ✓';
                            btn.classList.add('bg-[#d1fae5]', 'text-[#065f46]', 'cursor-default');
                            btn.classList.remove('bg-[#e7000b]', 'hover:bg-red-700', 'cursor-pointer');
                            btn.onclick = null;
                        } else if (isPlaced) {
                            btn.textContent = 'PLACEMENT COMPLETED';
                            btn.classList.add('bg-gray-200', 'text-gray-500', 'cursor-not-allowed');
                            btn.classList.remove('bg-[#e7000b]', 'hover:bg-red-700', 'cursor-pointer');
                            btn.title = "You have already been selected for a placement.";
                            btn.onclick = null;
                        }
                    }

                    document.getElementById('loadingIndicator').classList.add('hidden');
                    document.getElementById('jobDetailContent').classList.remove('hidden');
                } else {
                    document.getElementById('loadingIndicator').innerHTML = `<p class="text-red-500 font-bold">${data.message}</p>`;
                }
            } catch (err) {
                console.error(err);
                document.getElementById('loadingIndicator').innerHTML = '<p class="text-red-500 font-bold">Error loading job details.</p>';
            }
        }

        async function applyFromDetail() {
            if (!currentJobId) return;
            
            const btn = document.getElementById('applyBtn');
            const originalText = btn.innerHTML;
            
            try {
                btn.textContent = 'Applying...';
                btn.disabled = true;

                const res = await authFetch('/api/applications/apply', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ jobPostingId: parseInt(currentJobId) })
                });

                const result = await res.json();
                if (result.success) {
                    alert('Successfully applied for ' + document.getElementById('companyNameHeader').textContent);
                    window.location.reload();
                } else {
                    alert(result.message || 'Application failed');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred while applying.');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
}
</div>
