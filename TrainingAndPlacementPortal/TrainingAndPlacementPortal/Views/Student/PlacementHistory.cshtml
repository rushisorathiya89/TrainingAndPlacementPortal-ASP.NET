@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            if (!requireAuth('Student')) return;
            await loadPlacementHistory();
        });

        async function loadPlacementHistory() {
            const offersContainer = document.getElementById('finalOffersContainer');
            const recordsContainer = document.getElementById('placementRecordsList');
            
            try {
                const res = await authFetch('/api/applications/my-applications');
                if (!res || !res.ok) throw new Error('Fetch failed');
                const result = await res.json();
                
                if (result.success) {
                    renderHistory(result.data);
                }
            } catch (err) {
                console.error(err);
            }
        }

        function renderHistory(apps) {
            const offersContainer = document.getElementById('finalOffersList');
            const recordsContainer = document.getElementById('placementRecordsList');
            const welcomeSub = document.querySelector('.page-subtitle');

            // 1. Filter Final Offers (Status: Selected)
            const offers = apps.filter(a => a.applicationStatus === 'Selected');
            
            if (offers.length > 0) {
                welcomeSub.textContent = `Congratulations! You have ${offers.length} final offer(s).`;
                let offersHtml = '';
                offers.forEach(off => {
                    const appliedDate = new Date(off.appliedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    offersHtml += `
                    <div class="bg-white border text-left border-gray-200 p-6 md:p-8 rounded-[12px] shadow-sm w-full mb-6">
                        <div class="flex justify-between items-start mb-6">
                            <h2 class="text-[1.5rem] font-bold text-[#333] m-0">Final Offer: ${off.companyName}</h2>
                            <span class="inline-flex items-center gap-2 px-3 py-[6px] rounded-full text-[14px] font-bold bg-[#dcfae6] text-[#16a34a]">
                                <i class="fas fa-circle-check text-sm"></i>SELECTED
                            </span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-y-6 gap-x-8">
                            <div><p class="text-[#888] text-[0.85rem] font-medium mb-1 m-0">Company Name</p><p class="text-[1.1rem] font-bold text-[#333] m-0">${off.companyName}</p></div>
                            <div><p class="text-[#888] text-[0.85rem] font-medium mb-1 m-0">Job Role</p><p class="text-[1.05rem] font-bold text-[#444] m-0">${off.jobRole}</p></div>
                            <div><p class="text-[#888] text-[0.85rem] font-medium mb-1 m-0">Package</p><p class="text-[1.05rem] font-bold text-[#e7000b] m-0">${off.package}</p></div>
                            <div><p class="text-[#888] text-[0.85rem] font-medium mb-1 m-0">Offer Date</p><p class="text-[1.05rem] font-bold text-[#444] m-0">${appliedDate}</p></div>
                        </div>
                    </div>`;
                });
                document.getElementById('finalOffersContainer').innerHTML = offersHtml;
            } else {
                welcomeSub.textContent = "Track your placement applications and outcomes.";
                document.getElementById('finalOffersContainer').innerHTML = `
                    <div class="bg-gray-50 border border-dashed border-gray-300 p-10 rounded-[12px] text-center mb-10">
                        <p class="text-gray-400 font-bold uppercase text-sm m-0">No final offers secured yet. Keep applying!</p>
                    </div>`;
            }

            // 2. Filter Placement Records (All except Selected? Or all including selected? User said 'otherwise only show placement records with status' but also 'Placement Records ... complete history')
            // I'll show ALL in records as per the subtitle 'Complete history'
            if (apps.length === 0) {
                recordsContainer.innerHTML = '<div class="p-10 text-center text-gray-400 font-bold uppercase text-sm">No placement records found.</div>';
                return;
            }

            let recordsHtml = '';
            apps.forEach((app, i) => {
                const rowBg = i % 2 === 0 ? "bg-gray-50" : "bg-white";
                const appliedDate = new Date(app.appliedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
                
                // Status Styling
                let statusBg = "bg-[#dbeafe]", statusText = "text-[#3b82f6]", statusIcon = "fa-paper-plane";
                if (app.applicationStatus === 'Selected') { statusBg = "bg-[#dcfae6]"; statusText = "text-[#16a34a]"; statusIcon = "fa-circle-check"; }
                if (app.applicationStatus === 'Rejected') { statusBg = "bg-[#fee2e2]"; statusText = "text-[#dc2626]"; statusIcon = "fa-circle-xmark"; }
                if (app.applicationStatus === 'Shortlisted') { statusBg = "bg-[#f3e8ff]"; statusText = "text-[#a855f7]"; statusIcon = "fa-star"; }

                recordsHtml += `
                <div class="grid grid-cols-5 gap-4 px-8 py-[22px] items-center border-b border-gray-200 ${rowBg}">
                    <div class="flex items-center gap-4 col-span-1">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-[#d8cfc3] text-gray-700 font-bold">${app.companyName.charAt(0)}</div>
                        <span class="font-bold text-[#222] text-[15.5px] whitespace-nowrap">${app.companyName}</span>
                    </div>
                    <div class="text-[#555] text-[15px] text-center whitespace-nowrap overflow-hidden text-ellipsis px-1 font-semibold">${app.jobRole}</div>
                    <div class="font-bold text-[#333] text-[15px] text-center whitespace-nowrap uppercase">${app.package}</div>
                    <div class="text-[#666] text-[15px] text-center whitespace-nowrap font-bold lowercase">${appliedDate}</div>
                    <div class="flex justify-center">
                        <span class="inline-flex items-center gap-2 px-3 py-[6px] rounded-full text-[13px] font-bold ${statusBg} ${statusText}">
                            <i class="fas ${statusIcon} text-[11px]"></i>${app.applicationStatus.toUpperCase()}
                        </span>
                    </div>
                </div>`;
            });
            recordsContainer.innerHTML = recordsHtml;
        }
    </script>
}

<div class="w-full">
    <header class="page-header flex justify-between items-start mb-6">
        <div>
            <h1 class="page-title text-[#e7000b] text-[2rem] font-bold m-0 mb-2">Placement History</h1>
            <p class="page-subtitle text-[#666] text-base m-0">Loading your offers...</p>
        </div>
    </header>

    <div id="finalOffersContainer">
        <div class="animate-pulse bg-gray-100 h-40 rounded-xl mb-10"></div>
    </div>

    <div class="mb-6">
        <h2 class="text-[1.8rem] font-bold text-[#e7000b] m-0 mb-2">Placement Records</h2>
        <p class="text-[#64748b] text-[15px] font-medium m-0">Complete history of your placement applications and outcomes</p>
    </div>

    <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-200">
        <div class="overflow-x-auto hide-scrollbar">
            <div class="min-w-[900px]">
                <div class="grid grid-cols-5 gap-4 px-8 py-5 border-b border-gray-200 bg-[#fbfaf8]">
                    <div class="font-bold text-[#444] text-[11px] uppercase col-span-1 pl-[60px]">Company Name</div>
                    <div class="font-bold text-[#444] text-[11px] uppercase text-center">Job Role</div>
                    <div class="font-bold text-[#444] text-[11px] uppercase text-center">Package</div>
                    <div class="font-bold text-[#444] text-[11px] uppercase text-center">Date</div>
                    <div class="font-bold text-[#444] text-[11px] uppercase text-center">Status</div>
                </div>

                <div id="placementRecordsList" class="flex flex-col">
                    <div class="p-20 text-center"><i class="fas fa-spinner fa-spin text-2xl text-red-600"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

