@{ ViewData["Title"] = "Change Password"; }

<div class="min-h-screen flex flex-col bg-gray-200">
    <div class="flex-grow flex flex-col items-center justify-center px-4 py-12">
        <div class="text-center mb-8">
            <h1 class="text-2xl md:text-3xl font-bold">RK University <br /> Training &amp; Placement Cell</h1>
        </div>

        <div class="bg-[#d8cfc2] p-8 rounded-xl shadow-lg w-full max-w-md">
            <h2 class="text-xl font-bold text-center mb-2">Change Password</h2>
            <p class="text-center text-sm text-gray-600 mb-6">Update your account password</p>

            <!-- Current Password -->
            <div class="mb-4">
                <label class="text-sm font-medium">Current Password</label>
                <div class="relative mt-1">
                    <input type="password" id="currentPassword" placeholder="Enter current password" class="w-full p-2 rounded-md border" oninput="validateFieldRealtime('current')" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 bg-transparent border-none cursor-pointer" onclick="togglePassword('currentPassword', 'cpCurrIcon')"><i id="cpCurrIcon" class="fas fa-eye"></i></button>
                </div>
                <p id="currentError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- New Password -->
            <div class="mb-4">
                <label class="text-sm font-medium">New Password</label>
                <div class="relative mt-1">
                    <input type="password" id="newPassword" placeholder="Enter new password" class="w-full p-2 rounded-md border" oninput="validateFieldRealtime('new'); checkPasswordRequirements('newPassword')" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 bg-transparent border-none cursor-pointer" onclick="togglePassword('newPassword', 'cpNewIcon')"><i id="cpNewIcon" class="fas fa-eye"></i></button>
                </div>
                <p id="newError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label class="text-sm font-medium">Confirm New Password</label>
                <div class="relative mt-1">
                    <input type="password" id="confirmPassword" placeholder="Re-Enter new password" class="w-full p-2 rounded-md border" oninput="validateFieldRealtime('confirm')" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 bg-transparent border-none cursor-pointer" onclick="togglePassword('confirmPassword', 'cpConfirmIcon')"><i id="cpConfirmIcon" class="fas fa-eye"></i></button>
                </div>
                <p id="confirmError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Password Requirements -->
            <div class="bg-white border border-gray-200 p-4 rounded-lg mb-5 text-sm">
                <p class="font-bold text-gray-800 mb-2">Password requirements:</p>
                <ul class="space-y-1 text-gray-500 list-none p-0">
                    <li id="reqLength"><span class="req-icon">○</span> At least 8 characters long</li>
                    <li id="reqCase"><span class="req-icon">○</span> Contains uppercase and lowercase letters</li>
                    <li id="reqNumber"><span class="req-icon">○</span> Contains at least one number</li>
                    <li id="reqSpecial"><span class="req-icon">○</span> Contains at least one special character</li>
                </ul>
            </div>

            <div class="text-right text-sm mb-4">
                <a href="/Auth/ForgotPassword" class="hover:underline cursor-pointer text-gray-700 no-underline">Forgot Password?</a>
            </div>

            <button onclick="validateChangePassword()" class="w-full bg-red-600 text-white py-2 rounded-md hover:bg-red-700 transition mb-3 border-none cursor-pointer font-medium">Update Password</button>
            <button onclick="history.back()" class="w-full border border-black py-2 rounded-md hover:bg-gray-100 transition cursor-pointer bg-transparent font-medium">Cancel</button>
        </div>
    </div>
</div>
