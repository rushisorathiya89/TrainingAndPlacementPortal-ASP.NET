@{ ViewData["Title"] = "Reset Password"; }

<div class="min-h-screen flex flex-col bg-gray-200">
    <div class="flex-grow flex flex-col items-center justify-center px-4 py-12">
        <div class="text-center mb-8">
            <h1 class="text-2xl md:text-3xl font-bold">RK University <br /> Training &amp; Placement Cell</h1>
        </div>

        <div class="bg-[#d8cfc2] p-8 rounded-xl shadow-lg w-full max-w-md">
            <h2 class="text-xl font-bold text-center mb-2">Reset Password</h2>
            <p class="text-center text-sm text-gray-600 mb-6">Verify your identity and set a new password</p>

            <!-- Email -->
            <div class="mb-4">
                <label class="text-sm font-medium">Email Address</label>
                <div class="relative mt-1">
                    <input type="email" id="resetEmail" placeholder="Enter your college email" class="w-full p-2 pl-9 rounded-md border" oninput="validateFieldRealtime('resetEmail')" />
                    <i class="fas fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                </div>
                <p id="resetEmailError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- OTP -->
            <div class="mb-4">
                <label class="text-sm font-medium">OTP</label>
                <input type="text" id="resetOtp" placeholder="Enter 6-digit OTP" maxlength="6" class="w-full mt-1 p-2 rounded-md border" oninput="validateFieldRealtime('otp')" />
                <p id="otpError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- New Password -->
            <div class="mb-4">
                <label class="text-sm font-medium">New Password</label>
                <div class="relative mt-1">
                    <input type="password" id="resetNewPassword" placeholder="Enter new password" class="w-full p-2 rounded-md border" oninput="validateFieldRealtime('resetNew')" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 bg-transparent border-none cursor-pointer" onclick="togglePassword('resetNewPassword', 'rpNewIcon')"><i id="rpNewIcon" class="fas fa-eye"></i></button>
                </div>
                <p id="resetNewError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label class="text-sm font-medium">Confirm Password</label>
                <div class="relative mt-1">
                    <input type="password" id="resetConfirmPassword" placeholder="Confirm new password" class="w-full p-2 rounded-md border" oninput="validateFieldRealtime('resetConfirm')" />
                    <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 bg-transparent border-none cursor-pointer" onclick="togglePassword('resetConfirmPassword', 'rpConfirmIcon')"><i id="rpConfirmIcon" class="fas fa-eye"></i></button>
                </div>
                <p id="resetConfirmError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <button onclick="validateResetPassword()" class="w-full bg-red-600 text-white py-2 rounded-md hover:bg-red-700 transition mb-3 border-none cursor-pointer font-medium">Reset Password</button>
            <button onclick="history.back()" class="w-full border border-black py-2 rounded-md hover:bg-gray-100 transition cursor-pointer bg-transparent font-medium">Cancel</button>

            <div class="text-center mt-6 text-sm">
                <p>Remember your password? <a href="/Auth/Login" class="font-semibold cursor-pointer hover:underline text-gray-900">Login</a></p>
            </div>
        </div>
    </div>
</div>
